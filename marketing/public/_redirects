# Cloudflare Pages static routing.

# Unprefixed public paths use English by default.
/privacy /en/privacy/ 302
/privacy/ /en/privacy/ 302
/terms /en/terms/ 302
/terms/ /en/terms/ 302
/support /en/support/ 302
/support/ /en/support/ 302

# Invite links are served by the static join page until iOS universal links are wired.
/join/* /join/ 200

# Pass through Next/static assets.
/_next/* /_next/:splat 200
/.well-known/* /.well-known/:splat 200
/brand/* /brand/:splat 200
/favicon.ico /favicon.ico 200
/favicon.svg /favicon.svg 200
/favicon-32x32.png /favicon-32x32.png 200
/favicon-192x192.png /favicon-192x192.png 200
/apple-touch-icon.png /apple-touch-icon.png 200
/apple-touch-icon-precomposed.png /apple-touch-icon-precomposed.png 200
/site.webmanifest /site.webmanifest 200
/robots.txt /robots.txt 200
/sitemap.xml /sitemap.xml 200

# Pass through supported locales.
/no/* /no/:splat 200
/en/* /en/:splat 200

# Unsupported locale-looking paths fallback to English.
/:locale/* /en/:splat 302
