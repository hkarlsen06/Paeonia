// Release Configuration
// Includes shared version settings

#include "Version.xcconfig"

// Convex deployment. `https:/$()/` keeps xcconfig from reading `//` as a comment.
PAEONIA_CONVEX_URL = https:/$()/api.paeonia.no

// Clerk publishable key (pk_test_... or pk_live_...) from the Clerk dashboard
// under API keys. This is the development instance; switch to pk_live_ when the
// production Clerk instance exists. An empty key disables sign-in.
PAEONIA_CLERK_PUBLISHABLE_KEY = pk_test_dmVyaWZpZWQtYmFkZ2VyLTEwLmNsZXJrLmFjY291bnRzLmRldiQ

// PostHog project key (phc_...) for usage statistics, session replay and crash
// reports. It can only send events, so it is safe in the app. The project is on
// EU Cloud. An empty key turns all of it off.
PAEONIA_POSTHOG_PROJECT_KEY = phc_ruqiKvB8F5xvh5fMRt7oRAWpL8dhbvKjhzAhTQT3qqGg

// Photos for the Debug-only developer scenarios (App/DeveloperScenarios/MemoriesMapPhotos).
// The scenario code is compiled out of Release, so its photos are left out too.
EXCLUDED_SOURCE_FILE_NAMES = scenario-memory-*.jpg
