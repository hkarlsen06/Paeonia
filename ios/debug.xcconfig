// Debug Configuration
// Includes shared version settings

#include "Version.xcconfig"

// Convex deployment. `https:/$()/` keeps xcconfig from reading `//` as a comment.
PAEONIA_CONVEX_URL = https:/$()/api.paeonia.no

// Clerk publishable key of the production instance (clerk.paeonia.no). An empty
// key disables sign-in. Simulator builds use the development instance instead,
// so the test couple from scripts/test-couple can sign in there and a simulator
// can pair with a phone on production Clerk. api.paeonia.no trusts both
// (CLERK_JWT_ISSUER_DOMAIN and CLERK_DEV_JWT_ISSUER_DOMAIN).
PAEONIA_CLERK_PUBLISHABLE_KEY = pk_live_Y2xlcmsucGFlb25pYS5ubyQ
PAEONIA_CLERK_PUBLISHABLE_KEY[sdk=iphonesimulator*] = pk_test_dmVyaWZpZWQtYmFkZ2VyLTEwLmNsZXJrLmFjY291bnRzLmRldiQ

// PostHog project key (phc_...) for usage statistics, session replay and crash
// reports. It can only send events, so it is safe in the app. The project is on
// EU Cloud. An empty key turns all of it off.
PAEONIA_POSTHOG_PROJECT_KEY = phc_ruqiKvB8F5xvh5fMRt7oRAWpL8dhbvKjhzAhTQT3qqGg

// Optional and untracked. scripts/local-backend writes it to point Debug builds
// of a worktree at that worktree's local Convex backend. Last, so it overrides.
#include? "local.xcconfig"
