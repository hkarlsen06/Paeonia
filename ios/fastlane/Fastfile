# frozen_string_literal: true

default_platform(:ios)

def metadata_script
  "../Scripts/generate-appstore-metadata.mjs"
end

def paeonia_release_version
  version = File.read(File.expand_path("../Version.xcconfig", __dir__))[/^MARKETING_VERSION\s*=\s*(\S+)/, 1]
  UI.user_error!("MARKETING_VERSION is missing from Version.xcconfig") unless version
  version
end

def require_app_store_connect_api_key!
  required_env_vars = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH]
  missing_vars = required_env_vars.reject { |var| ENV[var] && !ENV[var].empty? }

  unless missing_vars.empty?
    UI.user_error!(
      "Missing required environment variables: #{missing_vars.join(', ')}\n" \
      "Set ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_PATH before uploading metadata."
    )
  end

  key_path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
  UI.user_error!("App Store Connect API key file not found at: #{key_path}") unless File.exist?(key_path)

  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path,
    in_house: false
  )
end

def upload_metadata_files(api_key)
  deliver(
    api_key: api_key,
    skip_binary_upload: true,
    skip_screenshots: true,
    skip_metadata: false,
    force: true,
    metadata_path: "fastlane/metadata",
    precheck_include_in_app_purchases: false
  )
end

platform :ios do
  desc "Generate App Store metadata files and upload them"
  lane :metadata do
    UI.message("Generating localized metadata files...")
    sh("bun", metadata_script)

    upload_metadata_files(require_app_store_connect_api_key!)
    UI.success("Metadata uploaded successfully.")
  end

  desc "Generate App Store metadata files without uploading"
  lane :generate_metadata do
    UI.message("Generating localized metadata files...")
    sh("bun", metadata_script)
    UI.success("Metadata files generated in fastlane/metadata.")
  end

  desc "Upload existing App Store metadata files without regenerating"
  lane :upload_metadata do
    upload_metadata_files(require_app_store_connect_api_key!)
    UI.success("Metadata uploaded successfully.")
  end

  desc "Validate App Store metadata source and generated files"
  lane :validate_metadata do
    UI.message("Validating metadata...")
    sh("bun", metadata_script, "--validate-only")
    UI.success("Metadata validation passed.")
  end

  desc "Replace App Store iPhone and iPad screenshots with ASConnectScreenshots/<version>/3d (no metadata)"
  lane :upload_screenshots do
    version = paeonia_release_version
    screenshots_path = File.expand_path("../ASConnectScreenshots/#{version}/3d", __dir__)
    UI.user_error!("No screenshots at #{screenshots_path}") unless Dir.exist?(screenshots_path)

    # Deliver rejects unknown files such as the preview strips, so stage one folder per locale
    # with only the iPhone and iPad renders. Deliver replaces every screenshot in each locale it
    # uploads, iPad included, so a locale without iPad renders would lose its iPad set.
    require "tmpdir"
    Dir.mktmpdir("paeonia-screenshots") do |staging|
      locales = Dir.children(screenshots_path).select { |name| File.directory?(File.join(screenshots_path, name)) }
      UI.user_error!("No locale folders in #{screenshots_path}") if locales.empty?
      locales.each do |locale|
        iphone = Dir.glob(File.join(screenshots_path, locale, "iPhone-*.png"))
        ipad = Dir.glob(File.join(screenshots_path, locale, "iPad-*.png"))
        UI.user_error!("Missing iPad screenshots for #{locale} in #{screenshots_path}/#{locale}") if iphone.any? && ipad.empty?

        FileUtils.mkdir_p(File.join(staging, locale))
        FileUtils.cp(iphone + ipad, File.join(staging, locale))
      end

      deliver(
        api_key: require_app_store_connect_api_key!,
        app_version: version,
        submit_for_review: false,
        skip_binary_upload: true,
        skip_metadata: true,
        skip_screenshots: false,
        overwrite_screenshots: true,
        screenshots_path: staging,
        force: true,
        precheck_include_in_app_purchases: false
      )
    end

    UI.success("Screenshots uploaded successfully.")
  end
end
