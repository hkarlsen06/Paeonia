    "appLock.footer" : {
      "comment" : "Footer under the app lock switch. Says the lock does not hide widgets or notifications, and that the phone's passcode always works.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Face ID or Touch ID doesn't work, you can always use your phone's passcode. The lock doesn't hide widgets or notifications. To keep those private, turn them off in your phone's settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis Face ID eller Touch ID ikke fungerer, kan du alltid bruke tilgangskoden til telefonen. Låsen skjuler ikke widgeter eller varsler. Slå dem av i innstillingene på telefonen hvis du vil holde dem private."
          }
        }
      }
    },
