    "reportAndLeave.confirm.blockMessage" : {
      "comment" : "Centered confirmation message when explicit blocking is enabled. The placeholder is the partner name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report will be sent, your relationship with %@ will end, and they will be blocked from pairing with you again. Shared content will no longer be available in the app. This can't be undone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporten din blir sendt, forholdet med %@ avsluttes, og personen blokkeres fra å koble seg til deg igjen. Delt innhold vil ikke lenger være tilgjengelig i appen. Dette kan ikke angres."
          }
        }
      }
    },
