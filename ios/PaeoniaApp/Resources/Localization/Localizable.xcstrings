    "appLock.footer" : {
      "comment" : "Footer under the app lock switch. Says the lock does not hide widgets or notifications, and that the phone's passcode always works.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Face ID or Touch ID doesn't work, you can always use your phone's passcode. The lock doesn't hide widgets or notifications. To keep those private, turn them off in your phone's settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis Face ID eller Touch ID ikke fungerer, kan du alltid bruke tilgangskoden til telefonen. Låsen skjuler ikke widgeter eller varsler. Slå dem av i innstillingene på telefonen hvis du vil holde dem private."
          }
        }
      }
    },
    "appLock.lockWith" : {
      "comment" : "Settings row and switch that turns on the app lock. %@ is Face ID, Touch ID, Optic ID or passcode.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock with %@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås med %@"
          }
        }
      }
    },
    "appLock.noPasscode.message" : {
      "comment" : "Explains that the app lock needs a passcode on the phone",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia unlocks with Face ID, Touch ID or your phone's passcode. This phone has no passcode yet, so there is nothing to unlock with. Add one in your phone's settings, then come back here."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia låses opp med Face ID, Touch ID eller tilgangskoden til telefonen. Denne telefonen har ingen tilgangskode ennå, så det er ingenting å låse opp med. Lag en i innstillingene på telefonen, og kom tilbake hit."
          }
        }
      }
    },
