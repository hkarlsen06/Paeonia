    "location.permissionPrimer.message" : {
      "comment" : "Privacy explanation shown before iOS asks for location access. %@ is the partner name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your latest location with %@. iOS will also ask if it can update while Paeonia is closed. That's up to you. Paeonia never saves a location history, and you can turn sharing off anytime in Settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del den nyeste posisjonen din med %@. iOS spør også om den kan oppdateres når Paeonia er lukket. Det bestemmer du. Paeonia lagrer aldri posisjonshistorikk, og du kan slå av deling når som helst i Innstillinger."
          }
        }
      }
    },
