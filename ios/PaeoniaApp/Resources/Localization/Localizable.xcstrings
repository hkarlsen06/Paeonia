    "streakDetail.message" : {
      "comment" : "Short, forgiving explanation that each partner must do one meaningful daily activity to keep the couple streak alive",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each of you does one small thing each day to keep the flame going. Answer questions, send a drawing, add a memory, or write a message. If one of you misses a day, it cools down, but you can always start again."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begge gjør én liten ting hver dag for å holde flammen i live. Svar på spørsmål, send en tegning, legg til et minne eller skriv en melding. Hvis én av dere hopper over en dag, kjølner den, men dere kan alltid begynne på nytt."
          }
        }
      }
    },
