    "piccante.tutorial.bite.message" : {
      "comment" : "Tutorial about taking a bite.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take turns lifting and biting chocolates. Whoever bites a chili loses, even if it is their own."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt på å løfte en sjokoladebit og ta en bit. Den som biter i en chili taper, også om det er deres egen."
          }
        }
      }
    },
    "piccante.tutorial.bite.title" : {
      "comment" : "Piccante game. tutorial bite title.",
      "extractionState" : "manual",
