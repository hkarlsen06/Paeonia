          }
        }
      }
    },
    "mail.delivery.together.tooSoon" : {
      "comment" : "Shown instead of the next-meeting option when the next visit starts too soon for a letter written now to arrive on its evening, and location can't tell when the partners meet",
      "extractionState" : "manual",
      "localizations" : {
