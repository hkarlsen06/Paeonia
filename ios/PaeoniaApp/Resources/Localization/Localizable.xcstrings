    "auth.deleteAccount.confirm.message" : {
      "comment" : "Message in the account deletion confirmation dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes your profile. If you are paired, it ends your relationship and hides shared content before it is deleted. Your App Store subscription does not cancel automatically. This cannot be undone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner profilen din. Hvis dere er sammenkoblet, avsluttes forholdet, og delt innhold skjules før det slettes. App Store-abonnementet avsluttes ikke automatisk. Dette kan ikke angres."
          }
        }
      }
    },
