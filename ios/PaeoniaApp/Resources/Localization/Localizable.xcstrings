        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjem litt varme"
          }
        }
      }
    },
    "piccante.tutorial.sniff.message" : {
      "comment" : "Tutorial about the private sniff.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once per game, sniff a chocolate before you bite. Only you learn if it hides a chili. Then take your bite."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én gang per spill kan du lukte på en sjokoladebit før du tar en bit. Bare du får vite om den skjuler en chili. Så tar du en bit."
          }
        }
      }
    },
