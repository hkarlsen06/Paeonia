    "ludo.hint.triesLeft" : {
      "comment" : "Line under the Ludo board after this person missed a 6 while none of their pawns is out. They get three tries to roll a 6. The number is the tries left, 1 or 2.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld try left to roll a 6"
                }
              },
              "other" : {
