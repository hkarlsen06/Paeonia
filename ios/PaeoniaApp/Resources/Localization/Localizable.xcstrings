    "appLock.noPasscode.message" : {
      "comment" : "Explains that the app lock needs a passcode on the phone",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia unlocks with Face ID, Touch ID or your phone's passcode. This phone has no passcode yet, so there is nothing to unlock with. Add one in your phone's settings, then come back here."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia låses opp med Face ID, Touch ID eller tilgangskoden til telefonen. Denne telefonen har ingen tilgangskode ennå, så det er ingenting å låse opp med. Lag en i innstillingene på telefonen, og kom tilbake hit."
          }
        }
      }
    },
