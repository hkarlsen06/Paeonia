    "admin.ban.confirmMessage" : {
      "comment" : "Message of the ban confirmation. Explains what happens to the banned person and their partner. The placeholder is the user's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s relationship ends now. Their partner will see \"This relationship is closed\". %@ will see a screen saying their account is closed. Lifting the ban later does not bring the relationship back."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdet til %@ avsluttes nå. Partneren ser «Dette forholdet er avsluttet». %@ ser en skjerm som sier at kontoen er stengt. Å oppheve utestengelsen senere gir ikke forholdet tilbake."
          }
        }
      }
    },
