    },
    "piccante.tutorial.hide.message" : {
      "comment" : "Tutorial about hiding a chili and an optional note.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each of you hides one chili. Add what your partner owes you if they lose. They see neither until the box opens."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dere gjemmer én chili hver. Skriv hva partneren din skylder deg hvis de taper. Partneren din ser ingen av delene før esken åpnes."
          }
        }
      }
    },
    "piccante.tutorial.hide.title" : {
      "comment" : "Piccante game. tutorial hide title.",
