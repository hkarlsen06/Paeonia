    "privacySafety.usage.toggleDescription" : {
      "comment" : "Explains the usage statistics switch in Privacy and safety",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells us which screens you open, which features you use, and when the app crashes. Never what you or your partner write, say, photograph or draw. PostHog stores it for us in Germany, and we never sell it. Turning this off also deletes what we have."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forteller oss hvilke skjermer du åpner, hvilke funksjoner du bruker, og når appen krasjer. Aldri det du eller partneren din skriver, sier, tar bilde av eller tegner. PostHog lagrer det for oss i Tyskland, og vi selger det aldri. Slår du dette av, sletter vi også det vi har."
          }
        }
      }
    },
    "privacySafety.usage.toggleTitle" : {
      "comment" : "Switch that lets Paeonia collect usage statistics, screen recordings with all content hidden, and crash reports from this phone",
      "extractionState" : "manual",
      "localizations" : {
