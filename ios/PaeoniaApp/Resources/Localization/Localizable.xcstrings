    "pairing.unpair.confirm.cancel" : {
      "comment" : "Cancel button that keeps the pairing. Shared by the paywall footer and the You-tab leave action.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay paired"
          }
