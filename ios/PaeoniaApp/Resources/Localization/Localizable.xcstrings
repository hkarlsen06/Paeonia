    "paywall.error.purchaseNotFinished.message" : {
      "comment" : "Banner message when the payment worked but Paeonia could not finish unlocking because the phone is offline. Tells the user what to do.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't finish opening Paeonia. Check your connection, then tap Restore purchases. You won't be charged again."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi klarte ikke å åpne Paeonia helt. Sjekk tilkoblingen, og trykk deretter på Gjenopprett kjøp. Du blir ikke belastet på nytt."
          }
        }
      }
    },
    "paywall.error.purchaseNotFinished.retryMessage" : {
      "comment" : "Banner message when the payment worked but Paeonia could not finish unlocking, and the phone is online. Tells the user to tap Restore purchases later.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong while opening Paeonia. Tap Restore purchases in a little while. You won't be charged again."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe gikk galt da Paeonia skulle åpnes. Trykk på Gjenopprett kjøp om litt. Du blir ikke belastet på nytt."
          }
        }
      }
    },
    "paywall.error.purchaseNotFinished.title" : {
