    "settings.purchases.details.footer" : {
      "comment" : "Footer under the subscription details. Says the details are Paeonia's record, that changes happen through Apple with the Manage subscription button, and that Restore purchases fixes a mismatch. Button names must match paywall.manageSubscription and paywall.restorePurchases.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is what Paeonia has saved about your subscription. Apple handles all payments, so to change your plan or cancel, tap Manage subscription. If something here doesn't match what Apple shows, tap Restore purchases."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er det Paeonia har lagret om abonnementet ditt. Apple tar seg av all betaling, så trykk på Administrer abonnement for å bytte plan eller si opp. Hvis noe her ikke stemmer med det Apple viser, trykk på Gjenopprett kjøp."
          }
        }
      }
    },
    "settings.purchases.details.footer.partnerPays" : {
      "comment" : "Footer under the subscription details when the partner pays. %@ is the partner's name. Only the person who pays can change the subscription in Apple's settings. Button name must match paywall.restorePurchases.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pays for this through Apple, so only they can change or cancel it. If something here looks wrong, ask them to tap Restore purchases on their phone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ betaler for dette gjennom Apple, så bare den som betaler kan endre eller si opp abonnementet. Hvis noe her ser feil ut, kan den som betaler trykke på Gjenopprett kjøp på sin telefon."
          }
        }
      }
    },
