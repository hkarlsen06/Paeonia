          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste besøk starter for snart til at du kan sende et brev til det. Velg et annet tidspunkt i stedet."
          }
        }
      }
    },
    "mail.delivery.together.unchecked" : {
      "comment" : "Under 'When we next meet' when the app could not check how the couple will meet. Not offline.",
      "extractionState" : "manual",
      "localizations" : {
