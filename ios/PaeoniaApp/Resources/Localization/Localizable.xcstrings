    "privacySafety.dataExport.description" : {
      "comment" : "Explains what Download my data gives you, under its title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a copy of what Paeonia keeps about you: your answers, messages, memories, photos and settings. You get files you can save or take to another app. What your partner wrote or uploaded is theirs, so it isn't included."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en kopi av det Paeonia har om deg: svar, meldinger, minner, bilder og innstillinger. Du får filer du kan lagre eller ta med til en annen app. Det partneren din har skrevet eller lastet opp, er partnerens eget, så det er ikke med."
          }
        }
      }
    },
