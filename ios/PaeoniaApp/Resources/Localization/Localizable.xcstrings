          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporten din blir sendt, og forholdet med %@ avsluttes. Delt innhold vil ikke lenger være tilgjengelig i appen. Dette kan ikke angres."
          }
        }
      }
    },
