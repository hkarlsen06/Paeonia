          "stringUnit" : {
            "state" : "translated",
            "value" : "Share usage statistics"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del bruksstatistikk"
          }
        }
      }
    },
