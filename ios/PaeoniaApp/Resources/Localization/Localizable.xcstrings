    "auth.accountClosed.message" : {
      "comment" : "Text under the title of the closed-account screen. The account was banned for breaking the rules.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia closed this account because it broke our rules, so the app no longer works with it. If you think this is a mistake, email us. If you pay for Paeonia, cancel the subscription so you aren't charged again."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia har stengt denne kontoen fordi den brøt reglene våre, så appen virker ikke lenger med den. Tror du dette er en feil, send oss en e-post. Hvis du betaler for Paeonia, si opp abonnementet så du ikke blir trukket igjen."
          }
        }
      }
    },
    "auth.accountClosed.title" : {
