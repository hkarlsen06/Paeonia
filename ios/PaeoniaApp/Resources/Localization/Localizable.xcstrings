    "settings.notifications.lockScreenDetails.subtitle" : {
      "comment" : "Explains the lock screen switch. Applies when the person has hidden previews in iOS Settings. %@ is the partner's name, used in an example of a locked notification. The example line is the partner's name, a colon, and the short line iOS shows for a new message.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your phone hides previews, a locked notification only says something like \"New message\". Turn this on to also see who it's from, like \"%@: New message\". What they wrote stays hidden."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis telefonen skjuler forhåndsvisning, står det bare noe som «Ny melding» på en låst skjerm. Slå på dette for også å se hvem det er fra, for eksempel «%@: Ny melding». Det de skrev, forblir skjult."
          }
        }
      }
    },
