    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paeonia uses your camera so you can take photos for your answers, messages, and memories."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker kameraet ditt så du kan ta bilder til svar, meldinger og minner."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses Face ID to unlock the app when you turn on the app lock."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker Face ID til å låse opp appen når du slår på applåsen."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "iOS prompt asking to change location access to Always. Shown right after the user turns on sharing, and when they turn on sharing while the app is closed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you allow this, Paeonia sends your location to your partner each time you move a good distance, even when you're not using the app. You can turn it off anytime in Settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du tillater dette, sender Paeonia posisjonen din til partneren din hver gang du flytter deg et godt stykke, også når du ikke bruker appen. Du kan slå det av når som helst i Innstillinger."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "iOS location permission prompt shown when the user turns on location sharing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses your location only when you turn on sharing, so your partner can see your latest location."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker posisjonen din bare når du slår på deling, slik at partneren din kan se den nyeste posisjonen din."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses your microphone so you can record voice answers and voice messages for your partner."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker mikrofonen din så du kan spille inn lydsvar og talemeldinger til partneren din."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia saves a picture to your photo library when you tap Save to Photos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia lagrer et bilde i bildebiblioteket ditt når du trykker på Lagre i Bilder."
          }
        }
      }
    },
    "NSUserNotificationsUsageDescription" : {
      "comment" : "iOS notification permission prompt shown before enabling alerts for partner activity and relationship reminders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia tells you when your partner answers, sends a message, or takes a turn in a game, and reminds you about the daily question."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia sier fra når partneren din svarer, sender en melding eller tar en tur i et spill, og minner deg på dagens spørsmål."
          }
        }
      }
    }
  },
  "version" : "1.0"
}