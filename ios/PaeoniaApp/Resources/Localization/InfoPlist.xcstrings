      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paeonia"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "PaeoniaApp"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses your camera so you can take photos for your answers, messages, memories, and stories, record story videos, and so your partner can see you on video calls."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker kameraet ditt så du kan ta bilder til svar, meldinger, minner og stories, spille inn story-videoer, og så partneren din kan se deg i videosamtaler."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses Face ID to unlock the app when you turn on the app lock."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker Face ID til å låse opp appen når du slår på applåsen."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "iOS prompt asking to change location access to Always. Shown right after the user turns on sharing, and when they turn on sharing while the app is closed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you allow this, Paeonia sends your location to your partner each time you move a good distance, even when you're not using the app. On a day your phones are less than 1 km apart, your streak can rest. You can turn it off anytime in Settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du tillater dette, sender Paeonia posisjonen din til partneren din hver gang du flytter deg et godt stykke, også når du ikke bruker appen. En dag telefonene deres er mindre enn 1 km fra hverandre, kan rekken hvile. Du kan slå det av når som helst i Innstillinger."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "iOS location permission prompt shown when the user turns on location sharing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses your location only when you turn on sharing. Your partner sees your latest location, and on a day your phones are less than 1 km apart, your streak can rest."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker posisjonen din bare når du slår på deling. Partneren din ser den nyeste posisjonen din, og en dag telefonene deres er mindre enn 1 km fra hverandre, kan rekken hvile."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses your microphone so you can talk to your partner on calls, record voice answers and voice messages, and record sound in story videos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker mikrofonen din så du kan snakke med partneren din i samtaler, spille inn lydsvar og talemeldinger, og ta opp lyd i story-videoer."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia saves a picture or video to your photo library when you tap Save to Photos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia lagrer et bilde eller en video i bildebiblioteket ditt når du trykker på Lagre i Bilder."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "comment" : "Privacy - Screen Capture Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia shows your screen to your partner during a call, only when you choose to share it."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia viser skjermen din til partneren din under en samtale, bare når du velger å dele den."
          }
        }
      }
    },
    "NSUserNotificationsUsageDescription" : {
      "comment" : "iOS notification permission prompt shown before enabling alerts for partner activity and relationship reminders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia tells you when your partner answers, sends a message, or takes a turn in a game, and reminds you about the daily question."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia sier fra når partneren din svarer, sender en melding eller tar en tur i et spill, og minner deg på dagens spørsmål."
          }
        }
      }
    }
  },
  "version" : "1.0"
}