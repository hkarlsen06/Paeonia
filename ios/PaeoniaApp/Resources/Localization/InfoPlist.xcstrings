    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paeonia uses your camera so you can take a photo to answer the daily question."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker kameraet ditt så du kan ta et bilde som svar på dagens spørsmål."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "iOS prompt shown when the user turns on sharing while the app is closed and iOS asks to allow location access Always.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you turn on \"Share while Paeonia is closed\", Paeonia sends your location to your partner each time you move a good distance, even when you're not using the app."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du slår på \"Del når Paeonia er lukket\", sender Paeonia posisjonen din til partneren din hver gang du flytter deg et godt stykke, også når du ikke bruker appen."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "iOS location permission prompt shown when the user turns on location sharing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses your location only when you turn on sharing, so your partner can see your latest location."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker posisjonen din bare når du slår på deling, slik at partneren din kan se den nyeste posisjonen din."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia uses your microphone so you can record voice answers and voice messages for your partner."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia bruker mikrofonen din så du kan spille inn lydsvar og talemeldinger til partneren din."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia saves a drawing to your photos when you tap save."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia lagrer en tegning i bildene dine når du trykker på lagre."
          }
        }
      }
    },
    "NSUserNotificationsUsageDescription" : {
      "comment" : "iOS notification permission prompt shown before enabling alerts for partner activity and relationship reminders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia sends notifications for partner drawings, answered questions, and check-in reminders."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeonia sender varsler om tegninger fra partneren din, svarte spørsmål og påminnelser om å sjekke inn."
          }
        }
      }
    }
  },
  "version" : "1.0"
