<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Paeonia</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>paeonia</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>paeonia</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Paeonia uses your camera so you can take photos for your answers, messages, and memories.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Paeonia uses Face ID to unlock the app when you turn on the app lock.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>If you allow this, Paeonia sends your location to your partner each time you move a good distance, even when you're not using the app. You can turn it off anytime in Settings.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Paeonia uses your location only when you turn on sharing, so your partner can see your latest location.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Paeonia uses your microphone so you can record voice answers and voice messages for your partner.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Paeonia saves a photo or drawing to your photo library when you tap Save to Photos.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Paeonia tells you when your partner answers, sends a message, or takes a turn in a game, and reminds you about the daily question.</string>
	<key>PaeoniaClerkPublishableKey</key>
	<string>$(PAEONIA_CLERK_PUBLISHABLE_KEY)</string>
	<key>PaeoniaConvexURL</key>
	<string>$(PAEONIA_CONVEX_URL)</string>
	<key>PaeoniaPostHogProjectKey</key>
	<string>$(PAEONIA_POSTHOG_PROJECT_KEY)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>PaeoniaLaunchPetalMark</string>
	</dict>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
