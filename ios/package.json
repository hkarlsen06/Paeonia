{
  "name": "paeonia-ios",
  "private": true,
  "version": "0.1.0",
  "description": "Paeonia iOS App Store metadata tooling",
  "scripts": {
    "generate-metadata": "bun Scripts/generate-appstore-metadata.mjs",
    "generate-metadata:force": "bun Scripts/generate-appstore-metadata.mjs --force",
    "generate-metadata:source-only": "bun Scripts/generate-appstore-metadata.mjs --source-only",
    "validate-metadata": "bun Scripts/generate-appstore-metadata.mjs --validate-only && node ../scripts/app-store.mjs validate",
    "upload-metadata": "node ../scripts/app-store.mjs metadata",
    "upload-review-metadata": "node ../scripts/app-store.mjs review-metadata",
    "upload-screenshots": "node ../scripts/app-store.mjs screenshots"
  }
}
