#!/bin/sh
[ "$(git branch --show-current)" = main ] || exit 0

# T3 removes a settled thread's worktree and keeps its branch, so landed
# branches pile up. Delete each branch that main contains and no worktree has
# checked out. T3 makes the branch again from main if its thread resumes.
git for-each-ref --merged=main --format='%(refname:short) %(worktreepath)' refs/heads |
  while read -r branch worktree; do
    [ "$branch" = main ] || [ -n "$worktree" ] || git branch -D "$branch"
  done

# Landing a change to scripts/ios-agent on main installs it for every agent on
# this Mac. install-user does nothing when the installed copy is current.
[ -x /usr/bin/python3 ] || exit 0
scripts/ios-agent install-user >/dev/null ||
  echo "ios-agent: not installed; run scripts/ios-agent install-user on main" >&2
exit 0
