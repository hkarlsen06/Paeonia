#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

STAGED_SWIFT_FILES="$(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E '\.swift$' || true
)"

if [ -z "$STAGED_SWIFT_FILES" ]; then
  exit 0
fi

# Only the staged files, so the tree's existing warnings don't bury the new ones.
echo "[pre-commit] Running SwiftLint on staged files"
echo "$STAGED_SWIFT_FILES" | tr '\n' '\0' | xargs -0 swiftlint lint --quiet

echo "[pre-commit] Checking Swift file length advisory"
scripts/check-swift-file-lengths.sh
