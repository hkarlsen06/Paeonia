# Paeonia local development environment.

# Backend operator commands (npx convex deploy, ios/Scripts/mint-review-codes.mjs).
# The iOS app does not read these. Its Convex URL and Clerk publishable key live in
# ios/debug.xcconfig and ios/release.xcconfig.
# Get the admin key with: ssh one-s cat /srv/paeonia/convex/admin-key
# Never commit the admin key. Prefer passing it inline instead of saving it here.
CONVEX_SELF_HOSTED_URL=https://api.paeonia.no
CONVEX_SELF_HOSTED_ADMIN_KEY=
