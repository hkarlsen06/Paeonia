#!/usr/bin/env bash
# Signs the Debug build of Paeonia on a simulator into one of the two test
# accounts on this worktree's local backend, without Apple or Google.
#
#   scripts/sim-sign-in "<simulator name or UDID>" <first|second> [--reset]
#
# first is Shared and second is Panci, the test couple that scripts/test-couple
# creates on the development Clerk instance. Only a worktree running
# scripts/local-backend can use them, because api.paeonia.no trusts production
# Clerk only. Build and install the app from that worktree first. The script
# mints a Clerk sign-in token that lasts five minutes and launches the app with
# it. The Debug build signs in with it when the app is signed out
# (DebugSignInTicket.swift), and the session then stays in the simulator's
# keychain. --reset clears that keychain first, to switch the simulator to the
# other account.
#
# It reads CLERK_DEV_SECRET_KEY from the api.paeonia.no env, which stores it for
# local backends, with the admin key (CONVEX_SELF_HOSTED_ADMIN_KEY, or read from
# one-s over ssh). The secret stays in memory and is never printed.
#
# After the launch it reads the account's access on the local backend, as that
# account, and warns when the couple is not paired or has no access. The check
# only reads.
set -euo pipefail

usage() {
  echo "usage: scripts/sim-sign-in \"<simulator name or UDID>\" <first|second> [--reset]" >&2
  exit 64
}

[[ $# -ge 2 ]] || usage
simulator=$1
case $2 in
  first) external_id=paeonia-test-first ;;
  second) external_id=paeonia-test-second ;;
  *) usage ;;
esac
reset=${3:-}
[[ -z $reset || $reset == --reset ]] || usage

bundle_id=no.paeonia.app
root=$(git rev-parse --show-toplevel)
local_port=$(sed -n 's#^PAEONIA_CONVEX_URL = .*127\.0\.0\.1:\([0-9]*\)$#\1#p' "$root/ios/local.xcconfig" 2>/dev/null || true)
[[ -n $local_port ]] || { echo "No local backend for this worktree. Start scripts/local-backend first." >&2; exit 1; }
# The Convex CLI needs Node 20 to 24 (backend/AGENTS.md).
export PATH="/opt/homebrew/opt/node@22/bin:$PATH"

if [[ ! -d $root/backend/node_modules ]]; then
  (cd "$root/backend" && npm ci --silent)
fi
admin_key=${CONVEX_SELF_HOSTED_ADMIN_KEY:-$(ssh one-s cat /srv/paeonia/convex/admin-key)}
secret=$(cd "$root/backend" && CONVEX_DEPLOYMENT= CONVEX_SELF_HOSTED_URL=https://api.paeonia.no \
  CONVEX_SELF_HOSTED_ADMIN_KEY=$admin_key npx convex env get CLERK_DEV_SECRET_KEY)
[[ -n $secret ]] || { echo "CLERK_DEV_SECRET_KEY is not set on api.paeonia.no" >&2; exit 1; }

# The header comes from stdin, so the secret never shows in the process list.
subject=$(curl -fsS "https://api.clerk.com/v1/users?external_id=$external_id" \
  -H @- <<<"Authorization: Bearer $secret" |
  python3 -c 'import json, sys; users = json.load(sys.stdin); print(users[0]["id"] if users else "")')
[[ -n $subject ]] || { echo "No $2 test account. Run scripts/test-couple first." >&2; exit 1; }
ticket=$(curl -fsS https://api.clerk.com/v1/sign_in_tokens \
  -H @- \
  -H "Content-Type: application/json" \
  -d "{\"user_id\":\"$subject\",\"expires_in_seconds\":300}" \
  <<<"Authorization: Bearer $secret" |
  python3 -c 'import json, sys; print(json.load(sys.stdin)["token"])')

xcrun simctl boot "$simulator" 2>/dev/null || true
xcrun simctl terminate "$simulator" "$bundle_id" 2>/dev/null || true
if [[ $reset == --reset ]]; then
  xcrun simctl keychain "$simulator" reset
fi
SIMCTL_CHILD_PAEONIA_DEBUG_SIGN_IN_TICKET=$ticket xcrun simctl launch "$simulator" "$bundle_id" >/dev/null
echo "Launched $bundle_id on $simulator as the $2 test account."

# The app's own access query, run as the signed-in account on the local backend,
# which the CLI reaches through backend/.env.local.
access=$(cd "$root/backend" && env -u CONVEX_SELF_HOSTED_URL -u CONVEX_SELF_HOSTED_ADMIN_KEY \
  npx convex run access:get_access_snapshot '{}' \
  --identity "{\"subject\":\"$subject\"}" --codegen disable --typecheck disable 2>/dev/null |
  python3 -c '
import json, sys
couple = json.load(sys.stdin)[0]["couple_entitlement"]
print("no-couple" if couple is None else "entitled" if couple["is_entitled"] else "lapsed")
' 2>/dev/null) || access=unknown

case $access in
  entitled) ;;
  no-couple | lapsed)
    echo "warning: the test couple is not paired or has no access ($access), so the app opens pairing or the paywall. Run scripts/test-couple." >&2
    ;;
  *)
    echo "warning: could not read the test couple's access from the local backend." >&2
    ;;
esac
