#!/usr/bin/env bash
# Signs the Debug build of Paeonia on a simulator into one of the two test
# accounts on api.paeonia.no, without Apple or Google.
#
#   scripts/sim-sign-in "<simulator name or UDID>" <first|second> [--reset]
#
# first is Hjalmar and second is Elena, the test couple. The app must already be
# installed on the simulator. The script mints a Clerk sign-in token that lasts
# five minutes and launches the app with it. The Debug build signs in with it
# when the app is signed out (DebugSignInTicket.swift), and the session then stays
# in the simulator's keychain. --reset clears that keychain first, to switch the
# simulator to the other account.
#
# It reads CLERK_SECRET_KEY from the hosted Convex env with the admin key
# (CONVEX_SELF_HOSTED_ADMIN_KEY, or read from one-s over ssh). The secret stays in
# memory and is never printed.
set -euo pipefail

usage() {
  echo "usage: scripts/sim-sign-in \"<simulator name or UDID>\" <first|second> [--reset]" >&2
  exit 64
}

[[ $# -ge 2 ]] || usage
simulator=$1
case $2 in
  first) subject=user_3KVUgELskLqEzQzJXz12wbkj2yS ;;
  second) subject=user_3KVV3oyVHCORVwIObVOjvLojmpe ;;
  *) usage ;;
esac
reset=${3:-}
[[ -z $reset || $reset == --reset ]] || usage

bundle_id=no.paeonia.app
root=$(git rev-parse --show-toplevel)
# The Convex CLI needs Node 20 to 24 (backend/AGENTS.md).
export PATH="/opt/homebrew/opt/node@22/bin:$PATH"

if [[ ! -d $root/backend/node_modules ]]; then
  (cd "$root/backend" && npm ci --silent)
fi
admin_key=${CONVEX_SELF_HOSTED_ADMIN_KEY:-$(ssh one-s cat /srv/paeonia/convex/admin-key)}
secret=$(cd "$root/backend" && CONVEX_DEPLOYMENT= CONVEX_SELF_HOSTED_URL=https://api.paeonia.no \
  CONVEX_SELF_HOSTED_ADMIN_KEY=$admin_key npx convex env get CLERK_SECRET_KEY)
[[ -n $secret ]] || { echo "CLERK_SECRET_KEY is not set on the hosted deployment" >&2; exit 1; }

# The header comes from stdin, so the secret never shows in the process list.
ticket=$(curl -fsS https://api.clerk.com/v1/sign_in_tokens \
  -H @- \
  -H "Content-Type: application/json" \
  -d "{\"user_id\":\"$subject\",\"expires_in_seconds\":300}" \
  <<<"Authorization: Bearer $secret" |
  python3 -c 'import json, sys; print(json.load(sys.stdin)["token"])')

xcrun simctl boot "$simulator" 2>/dev/null || true
xcrun simctl terminate "$simulator" "$bundle_id" 2>/dev/null || true
if [[ $reset == --reset ]]; then
  xcrun simctl keychain "$simulator" reset
fi
SIMCTL_CHILD_PAEONIA_DEBUG_SIGN_IN_TICKET=$ticket xcrun simctl launch "$simulator" "$bundle_id" >/dev/null
echo "Launched $bundle_id on $simulator as the $2 test account."
