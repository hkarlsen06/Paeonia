#!/usr/bin/env bash
# Runs this worktree's backend/convex on a local Convex backend, so a branch can
# be tested end to end on a simulator without deploying to api.paeonia.no.
#
#   scripts/local-backend [--reseed]
#
# It runs `convex dev`, which pushes the functions again whenever a file in
# backend/convex changes. Stop it with Ctrl-C or kill. The data stays in
# backend/.convex, and the next run reuses it.
#
# Each worktree gets its own pair of ports, picked from a hash of the worktree
# path, so the URL stays the same across restarts. The script writes the
# untracked ios/local.xcconfig, which points Debug builds of this worktree at
# the local backend and at the development Clerk instance. Delete that file to
# use api.paeonia.no and production Clerk again.
#
# A local backend trusts the development Clerk instance, never production. Every
# run copies the env vars in copy_vars from api.paeonia.no, and the development
# Clerk issuer and secret key from CLERK_DEV_JWT_ISSUER_DOMAIN and
# CLERK_DEV_SECRET_KEY there (api.paeonia.no itself ignores those two). The
# values go through pipes, so they never show in the process list or land in a
# file. APNs and Apple keys are left out, so a local backend sends no pushes and
# never talks to Apple. On the first run, or with --reseed, it also replaces all
# local data with a snapshot of api.paeonia.no (every table and stored file).
# Until a copy succeeds, every run starts again from an empty backend and copies
# again. Then it runs scripts/test-couple, so the test couple Shared and Panci
# exist, paired and entitled. Reading the hosted deployment needs the admin key
# (CONVEX_SELF_HOSTED_ADMIN_KEY, or read from one-s over ssh).
set -euo pipefail

reseed=false
case ${1:-} in
  "") ;;
  --reseed) reseed=true ;;
  *) echo "usage: scripts/local-backend [--reseed]" >&2; exit 64 ;;
esac

copy_vars=(INVITE_CODE_PEPPER PAEONIA_MEDIA_URL_SECRET PAEONIA_LIVE_RELAY_URL
  PAEONIA_LIVE_RELAY_SECRET POSTHOG_PERSONAL_API_KEY)

root=$(git rev-parse --show-toplevel)
# ponytail: ports from a path hash, 300 pairs. Two worktrees can collide, and
# the second then stops at the check below. Store a chosen port per worktree if
# that ever happens.
port=$((3300 + $(printf %s "$root" | cksum | cut -d' ' -f1) % 300 * 2))
site_port=$((port + 1))
for p in "$port" "$site_port"; do
  if pid=$(lsof -ti "tcp:$p" -sTCP:LISTEN | head -1); then
    echo "Port $p is in use by pid $pid ($(ps -p "$pid" -o comm=)). This worktree needs ports $port and $site_port." >&2
    echo "If it is a leftover backend of this worktree, stop it with: kill $pid" >&2
    exit 1
  fi
done
cd "$root/backend"
# The Convex CLI needs Node 20 to 24 (backend/AGENTS.md).
export PATH="/opt/homebrew/opt/node@22/bin:$PATH"
[[ -d node_modules ]] || npm ci --silent

admin_key=${CONVEX_SELF_HOSTED_ADMIN_KEY:-$(ssh one-s cat /srv/paeonia/convex/admin-key)}
# Every command below without hosted() goes to the local backend, never to
# api.paeonia.no, even when the caller's shell points the CLI there.
unset CONVEX_SELF_HOSTED_URL CONVEX_SELF_HOSTED_ADMIN_KEY CONVEX_DEPLOYMENT
hosted() {
  CONVEX_DEPLOYMENT= CONVEX_SELF_HOSTED_URL=https://api.paeonia.no \
    CONVEX_SELF_HOSTED_ADMIN_KEY=$admin_key npx convex "$@"
}

# Written once the hosted copy is in and the functions are pushed over it.
copied=.convex/local/default/hosted-copy-done
[[ -f $copied ]] || reseed=true
# The snapshot must go into an empty backend, before the first push. The first
# push numbers tables in name order, and the snapshot brings the hosted numbers,
# which follow creation order. Imported over a pushed backend, a table that the
# schema has and the snapshot lacks gets the next local number, which can belong
# to a snapshot table ("conflict between ... with table number ..."). Imported
# first, the snapshot takes its numbers, and the push numbers new tables after.
$reseed && rm -rf "$copied" .convex/local/default/convex_local_backend.sqlite3* \
  .convex/local/default/convex_local_storage

dev_issuer=$(hosted env get CLERK_DEV_JWT_ISSUER_DOMAIN)
[[ -n $dev_issuer ]] || { echo "CLERK_DEV_JWT_ISSUER_DOMAIN is not set on api.paeonia.no" >&2; exit 1; }
# A Clerk publishable key is the Frontend API host and a dollar sign, in base64 without padding.
dev_publishable_key=pk_test_$(printf '%s$' "${dev_issuer#https://}" | base64 | tr -d '=')

cat >"$root/ios/local.xcconfig" <<EOF
// Written by scripts/local-backend. Debug builds of this worktree use its local
// Convex backend and the development Clerk instance it trusts. Delete this file
// to use api.paeonia.no and production Clerk again.
PAEONIA_CONVEX_URL = http:/\$()/127.0.0.1:$port
PAEONIA_CLERK_PUBLISHABLE_KEY = $dev_publishable_key
EOF

work=$(mktemp -d)
log=$work/dev.log
set -m # own process group, so convex dev gets the SIGINT it needs to stop the backend
CONVEX_AGENT_MODE=anonymous ./node_modules/.bin/convex dev \
  --local-cloud-port "$port" --local-site-port "$site_port" > >(tee "$log") 2>&1 &
dev_pid=$!
stop() {
  kill -INT "$dev_pid" 2>/dev/null || true
  wait "$dev_pid" 2>/dev/null || true
  rm -rf "$work"
}
trap stop EXIT
trap 'exit 130' INT TERM

wait_for() {
  for _ in $(seq 1 180); do
    kill -0 "$dev_pid" 2>/dev/null || { echo "convex dev exited" >&2; exit 1; }
    "$@" && return 0
    sleep 1
  done
  echo "Timed out waiting for the local backend" >&2
  exit 1
}

pushed() {
  if grep -q "Schema validation failed" "$log"; then
    echo "The data does not fit this branch's schema. Fix the schema or the data, then run again." >&2
    exit 1
  fi
  grep -q "Convex functions ready" "$log"
}

wait_for curl -fs -o /dev/null "http://127.0.0.1:$port/instance_name"
# The first push of a new backend fails until CLERK_JWT_ISSUER_DOMAIN is set,
# and convex dev retries on its own once the env vars change. The import runs
# before it is set, so the push comes after the import.
for name in "${copy_vars[@]}"; do
  hosted env get "$name" | npx convex env set "$name" >/dev/null 2>&1 ||
    { echo "Could not copy $name from api.paeonia.no" >&2; exit 1; }
done
if $reseed; then
  echo "Copying the data on api.paeonia.no to the local backend..."
  hosted export --include-file-storage --path "$work/hosted.zip" >/dev/null
  npx convex import --replace-all -y "$work/hosted.zip" 2>&1 | tail -3 ||
    { echo "Could not import the data from api.paeonia.no" >&2; exit 1; }
  rm -f "$work/hosted.zip"
fi
printf '%s' "$dev_issuer" | npx convex env set CLERK_JWT_ISSUER_DOMAIN >/dev/null 2>&1 &&
  hosted env get CLERK_DEV_SECRET_KEY | npx convex env set CLERK_SECRET_KEY >/dev/null 2>&1 ||
  { echo "Could not set the development Clerk instance on the local backend" >&2; exit 1; }
wait_for pushed
$reseed && touch "$copied"
"$root/scripts/test-couple"

cat <<EOF

Local backend for $root
  Client API:   http://127.0.0.1:$port
  HTTP actions: http://127.0.0.1:$site_port
ios/local.xcconfig points Debug builds of this worktree here, with the
development Clerk key. Build and install the app from this worktree, then sign
in as the test couple with scripts/sim-sign-in.
EOF
wait "$dev_pid"
