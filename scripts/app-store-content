ROW_LIMIT = 10000  # The most rows `npx convex data` lists; it fails on far larger limits.
DAILY_SHUFFLE_LIMIT = 30  # DAILY_SHUFFLE_LIMIT in backend/convex/daily.ts, per person per day.
# A round of 60 skips sees 61 of the 156 questions, so 25 rounds all miss about once in 200,000 runs.
DAILY_RESET_LIMIT = 25
