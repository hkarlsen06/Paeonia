#!/usr/bin/env python3
# Creates the test couple on api.paeonia.no, or finishes it when part of it is
# missing, so it is safe to run again after the hosted data was wiped.
#
#   scripts/test-couple
#
# The two accounts are users of the development Clerk instance, which simulator
# builds sign in through and api.paeonia.no also trusts. They are found by
# external id (paeonia-test-first is Shared, paeonia-test-second is Panci) and
# are linked to no Apple or Google account. Their email addresses are made up and
# marked verified, because a sign-in ticket needs an identifier. Each account
# signs in with a ticket, finishes onboarding with a photo, and Shared gets an
# active test grant so the couple has access without a purchase. Then Shared
# invites Panci.
#
# It reads CLERK_DEV_SECRET_KEY and CLERK_DEV_JWT_ISSUER_DOMAIN from the hosted
# Convex env with the admin key (CONVEX_SELF_HOSTED_ADMIN_KEY, or read from one-s
# over ssh). Secrets and tokens stay in memory and are never printed.
# scripts/sim-sign-in signs the simulator into these accounts.
import hashlib
import json
import os
import secrets
import subprocess
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
HOSTED_URL = "https://api.paeonia.no"
PHOTOS = ROOT / "ios/PaeoniaApp/App/DeveloperScenarios/MemoriesMapPhotos"
ACCOUNTS = [
    {"external_id": "paeonia-test-first", "name": "Shared", "email": "test-shared@paeonia.no",
     "photo": "scenario-memory-bergen-bryggen.jpg"},
    {"external_id": "paeonia-test-second", "name": "Panci", "email": "test-panci@paeonia.no",
     "photo": "scenario-memory-copenhagen-nyhavn.jpg"},
]
# PairingInviteCode's alphabet: Crockford base32 without I, L and O.
CODE_ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


class Convex:
    def __init__(self) -> None:
        self.admin_key = os.environ.get("CONVEX_SELF_HOSTED_ADMIN_KEY") or subprocess.check_output(
            ["ssh", "one-s", "cat", "/srv/paeonia/convex/admin-key"], text=True).strip()
        self.env = {**os.environ, "CONVEX_DEPLOYMENT": "", "CONVEX_SELF_HOSTED_URL": HOSTED_URL,
                    "CONVEX_SELF_HOSTED_ADMIN_KEY": self.admin_key,
                    # The Convex CLI needs Node 20 to 24 (backend/AGENTS.md).
                    "PATH": "/opt/homebrew/opt/node@22/bin:" + os.environ["PATH"]}

    def cli(self, *args: str) -> str:
        return subprocess.check_output(["npx", "convex", *args], cwd=ROOT / "backend", env=self.env, text=True)

    def env_get(self, name: str) -> str:
        return self.cli("env", "get", name).strip()

    def call(self, token: str, kind: str, path: str, args: dict):
        body = json.dumps({"path": path, "args": args, "format": "json"}).encode()
        request = urllib.request.Request(f"{HOSTED_URL}/api/{kind}", data=body, method="POST", headers={
            "Content-Type": "application/json", "Authorization": f"Bearer {token}"})
        with urllib.request.urlopen(request) as response:
            result = json.load(response)
        if result.get("status") != "success":
            raise SystemExit(f"{path} failed: {result.get('errorMessage') or result}")
        return result["value"]


def http_json(url: str, *, method: str = "GET", headers: dict | None = None, data: bytes | None = None):
    request = urllib.request.Request(url, data=data, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(request) as response:
            return json.load(response), response.headers
    except urllib.error.HTTPError as error:
        raise SystemExit(f"{method} {url.split('?')[0]} failed with {error.code}: {error.read()[:300]!r}")


class Clerk:
    def __init__(self, secret: str, frontend_api: str) -> None:
        self.secret = secret
        self.frontend_api = frontend_api

    def api(self, method: str, path: str, payload: dict | None = None):
        data = json.dumps(payload).encode() if payload is not None else None
        return http_json(f"https://api.clerk.com/v1{path}", method=method, data=data, headers={
            "Authorization": f"Bearer {self.secret}", "Content-Type": "application/json"})[0]

    def ensure_user(self, account: dict) -> str:
        query = urllib.parse.urlencode({"external_id": account["external_id"]})
        found = self.api("GET", f"/users?{query}")
        if found:
            user = found[0]
        else:
            user = self.api("POST", "/users", {
                "external_id": account["external_id"], "first_name": account["name"], "last_name": "Test",
                "public_metadata": {"paeonia_test_account": True}})
        if not user["email_addresses"]:
            self.api("POST", "/email_addresses", {
                "user_id": user["id"], "email_address": account["email"], "verified": True, "primary": True})
        if user["external_accounts"]:
            raise SystemExit(f"{account['name']} is linked to {user['external_accounts'][0]['provider']}; refusing to use it")
        return user["id"]

    def convex_token(self, user_id: str) -> str:
        ticket = self.api("POST", "/sign_in_tokens", {"user_id": user_id, "expires_in_seconds": 300})["token"]
        form = urllib.parse.urlencode({"strategy": "ticket", "ticket": ticket}).encode()
        body, headers = http_json(f"{self.frontend_api}/v1/client/sign_ins?_is_native=1", method="POST", data=form,
                                  headers={"Content-Type": "application/x-www-form-urlencoded"})
        session_id = body["response"]["created_session_id"]
        token, _ = http_json(f"{self.frontend_api}/v1/client/sessions/{session_id}/tokens/convex?_is_native=1",
                             method="POST", headers={"Authorization": headers["Authorization"]})
        return token["jwt"]


def operation(sequence: int) -> dict:
    return {"p_client_operation_id": str(uuid.uuid4()), "p_client_id": str(uuid.uuid4()),
            "p_client_sequence": sequence, "p_local_created_at": now_iso()}


def upload_profile_photo(convex: Convex, token: str, user_id: str, photo: Path) -> str:
    data = photo.read_bytes()
    width, height = (int(value) for value in subprocess.check_output(
        ["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(photo)], text=True).split()[-3::2])
    reserve = {**operation(1), "p_reserved_parent_kind": "profile_photo", "p_reserved_parent_id": user_id,
               "p_upload_purpose": "profile_photo", "p_media_type": "image", "p_file_extension": "jpg"}
    [row] = convex.call(token, "mutation", "media:create_pending_media_upload", reserve)
    stored, _ = http_json(row["upload_url"], method="POST", data=data, headers={"Content-Type": "image/jpeg"})
    convex.call(token, "mutation", "media:finalize_media_upload", {
        **operation(2), "p_media_asset_id": row["media_asset_id"],
        "p_reserved_by_client_operation_id": reserve["p_client_operation_id"], "p_bucket": row["bucket"],
        "p_storage_path": row["storage_path"], "p_storage_id": stored["storageId"],
        "p_reserved_parent_kind": "profile_photo", "p_reserved_parent_id": user_id,
        "p_upload_purpose": "profile_photo", "p_media_type": "image", "p_mime_type": "image/jpeg",
        "p_byte_size": len(data), "p_sha256_hex": hashlib.sha256(data).hexdigest(),
        "p_width": width, "p_height": height})
    return row["media_asset_id"]


def ensure_test_grant(convex: Convex, user_id: str) -> None:
    rows = convex.cli("data", "entitlement_grants", "--limit", "1000", "--format", "jsonLines").splitlines()
    for line in rows:
        grant = json.loads(line)
        if grant["user_id"] == user_id and grant["grant_kind"] == "test" and grant["status"] == "active":
            return
    now = now_iso()
    grant = {"id": str(uuid.uuid4()), "user_id": user_id, "grant_kind": "test", "status": "active",
             "scope": "user", "reason": "test couple (scripts/test-couple)", "granted_by": "scripts/test-couple",
             "granted_at": now, "created_at": now, "updated_at": now}
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl") as file:
        file.write(json.dumps(grant) + "\n")
        file.flush()
        convex.cli("import", "--table", "entitlement_grants", "--append", "-y", "--format", "jsonLines", file.name)


def main() -> None:
    convex = Convex()
    clerk = Clerk(convex.env_get("CLERK_DEV_SECRET_KEY"), convex.env_get("CLERK_DEV_JWT_ISSUER_DOMAIN"))
    people = []
    for account in ACCOUNTS:
        clerk_id = clerk.ensure_user(account)
        token = clerk.convex_token(clerk_id)
        launch = convex.call(token, "mutation", "identity:launch", {})
        user_id = launch["profile"]["user_id"]
        if launch["profile"].get("onboarding_completed_at") is None:
            convex.call(token, "mutation", "identity:update_own_profile", {"p_display_name": account["name"]})
            photo_id = upload_profile_photo(convex, token, user_id, PHOTOS / account["photo"])
            convex.call(token, "mutation", "identity:complete_profile_onboarding",
                        {"p_time_zone_id": "Europe/Oslo", "p_profile_photo_asset_id": photo_id})
        people.append({**account, "clerk_id": clerk_id, "user_id": user_id, "token": token})
        print(f"{account['name']}: Clerk {clerk_id}, Paeonia {user_id}, onboarded")

    first, second = people
    ensure_test_grant(convex, first["user_id"])
    access = convex.call(first["token"], "query", "access:get_access_snapshot", {})
    if access["relationship_state"] is None:
        code = "".join(secrets.choice(CODE_ALPHABET) for _ in range(6))
        convex.call(first["token"], "mutation", "pairing:create_pairing_invite", {"p_invite_code": code, **operation(3)})
        convex.call(second["token"], "mutation", "pairing:accept_pairing_invite", {"p_invite_code": code, **operation(4)})
    for person in people:
        access = convex.call(person["token"], "query", "access:get_access_snapshot", {})
        couple = access["couple_entitlement"] or {}
        print(f"{person['name']}: couple {couple.get('couple_id')}, entitled {couple.get('is_entitled')}")


main()
