#!/usr/bin/python3
from __future__ import annotations

import argparse
import contextlib
import dataclasses
import fcntl
import json
import math
import os
from pathlib import Path
import re
import plistlib
import signal
import subprocess
import sys
import tempfile
import time


SIMULATORS = (
    ("Shared iPhone", "8E84ADB0-9092-4EB4-839E-71D62A350146"),
    ("Shared iPhone 2", "79EBB58E-1108-4EEE-987D-E193CEA9EA2A"),
    ("Shared iPhone 3", "4C6FDCA3-E72C-4FA1-B516-4E2CF7A3475C"),
)
APPROVED_DEVICES = {"00008150-000230D82E40401C"}
DEVICE_FEATURES = {"com.apple.coredevice.feature." + name
                   for name in ("installapp", "launchapplication", "processcontrol")}
QUERIES = {"-version", "-help", "--help", "-list", "-showdestinations",
           "-showsdks", "-showBuildSettings", "-showBuildSettingsForIndex"}
BUILD_ACTIONS = ("build", "clean", "archive", "test", "build-for-testing", "-resolvePackageDependencies")
ACTIONS = BUILD_ACTIONS + ("test-without-building",)
# Options whose value is a free name or path, which may spell an action, as in -derivedDataPath build.
FREE_VALUES = {"-derivedDataPath", "-resultBundlePath", "-resultStreamPath", "-archivePath", "-exportPath",
               "-exportOptionsPlist", "-project", "-workspace", "-scheme", "-target", "-configuration", "-sdk",
               "-xctestrun", "-testPlan", "-xcconfig", "-toolchain", "-clonedSourcePackagesDirPath", "-packageCachePath"}
# Seconds without a heartbeat before a ticket's owner counts as gone.
STALE = 60
# Seconds a requester that left the line while waiting keeps its place.
RESERVED = 900
# Seconds an extra simulator stays booted after its reservation ends. A boot takes about 45 seconds
# and five cores, and nearly half of the runs on an extra simulator start within five minutes of the last.
WARM = 300
STATE = Path.home() / ".local/state/ios-agent"


def log(message):
    # A closed stderr must not end the supervisor while Xcode runs.
    with contextlib.suppress(OSError):
        print(f"[ios-agent] {message}", file=sys.stderr, flush=True)


def actions(arguments):
    return [arg for index, arg in enumerate(arguments)
            if arg in ACTIONS and (index == 0 or arguments[index - 1] not in FREE_VALUES)]


def simulator_count():
    value = os.environ.get("IOS_AGENT_SIMULATORS", "3")
    if value not in ("1", "2", "3"):
        raise ValueError("IOS_AGENT_SIMULATORS must be 1, 2 or 3")
    return int(value)


def check_simulator(target):
    allowed = SIMULATORS[:simulator_count()]
    if not any(target in pair for pair in allowed):
        raise ValueError(f"{target} is outside the shared simulator pool; "
                         "take a simulator through scripts/lock and use the one it names")


@contextlib.contextmanager
def simulator_guard(directory):
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / "guard").open("a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        yield


def grant_simulator(target, directory=None, lock_root=None, ttl_seconds=None):
    check_simulator(target)
    slot = next(index for index, pair in enumerate(SIMULATORS) if target in pair)
    if slot == 0:
        return
    directory = directory or STATE / "simulators"
    lock_root = lock_root or Path(os.environ.get("AGENT_SIMULATOR_LOCK_ROOT", "/tmp/agent-locks"))
    owner_path = lock_root / f"simulator-{slot + 1}" / "owner"
    with simulator_guard(directory):
        try:
            owner = owner_path.read_text().strip()
        except FileNotFoundError:
            raise ValueError("take the extra simulator through scripts/lock before booting it")
        lease = directory / SIMULATORS[slot][1]
        inode = owner_path.parent.stat().st_ino
        if ttl_seconds is None:
            ttl_seconds = 60 * int(os.environ.get("PAEONIA_LOCK_TTL_MINUTES", os.environ.get("TIDEX_LOCK_TTL_MINUTES", "10")))
            try:
                previous = json.loads(lease.read_text())
                if previous["inode"] == inode and previous["owner"].split("|")[0] == owner.split("|")[0]:
                    ttl_seconds = previous["ttl"]
            except (OSError, ValueError, KeyError, TypeError):
                pass
        ttl_seconds = int(ttl_seconds)
        if ttl_seconds < 0:
            raise ValueError("simulator reservation TTL must be nonnegative")
        temporary = directory / f"{lease.name}-{os.getpid()}"
        temporary.write_text(json.dumps({"owner": owner, "path": str(owner_path), "inode": inode, "ttl": ttl_seconds}))
        temporary.replace(lease)
        # A reservation shorter than the enforcer's interval must still start a new warm period.
        (directory / f"{lease.name}.idle").unlink(missing_ok=True)


def simulator_reserved(udid, directory):
    try:
        lease = json.loads((directory / udid).read_text())
        owner_path = Path(lease["path"])
        owner = owner_path.read_text().strip()
        if owner_path.parent.stat().st_ino != lease["inode"]:
            return False
        worktree, pid, renewed = owner.split("|")
        if worktree != lease["owner"].split("|")[0]:
            return False
        return bool(worktree) and (process_alive(int(pid)) if pid else time.time() - int(renewed) < int(lease["ttl"]))
    except (OSError, ValueError, KeyError, TypeError):
        return False


def memory_critical():
    """Whether the kernel reports critical memory pressure, the red level in Activity Monitor.

    The warning level does not count. A second booted simulator alone puts this Mac there.
    """
    try:
        level = subprocess.run(["/usr/sbin/sysctl", "-n", "kern.memorystatus_vm_pressure_level"],
                               capture_output=True, text=True, timeout=5, check=True).stdout.strip()
        return level not in ("1", "2")
    except (subprocess.SubprocessError, OSError):
        return True


def enforce_simulators(directory=None):
    """Shuts down each extra simulator that nobody has reserved for WARM seconds.

    A booted simulator holds about 5 GB, so it goes at once while memory pressure is critical.
    """
    directory = directory or STATE / "simulators"
    with simulator_guard(directory):
        result = subprocess.run(["/usr/bin/xcrun", "simctl", "list", "devices", "booted", "--json"],
                                capture_output=True, text=True, timeout=15, check=True)
        booted = {device["udid"] for devices in json.loads(result.stdout)["devices"].values()
                  for device in devices if device.get("state") == "Booted"}
        for name, udid in SIMULATORS[1:]:
            # The age of this file is how long the simulator has been booted without a reservation.
            idle = directory / f"{udid}.idle"
            if udid not in booted or simulator_reserved(udid, directory):
                idle.unlink(missing_ok=True)
                continue
            if not idle.exists():
                idle.touch()
            unreserved = time.time() - idle.stat().st_mtime
            if unreserved >= WARM:
                log(f"shutting down {name}; no reservation for {duration(unreserved)}")
            elif memory_critical():
                log(f"shutting down {name}; no reservation, and memory pressure is critical")
            else:
                continue
            subprocess.run(["/usr/bin/xcrun", "simctl", "shutdown", udid], timeout=15, check=True)
            idle.unlink()


def destinations(arguments):
    for index, arg in enumerate(arguments):
        raw = None
        if arg == "-destination" and index + 1 < len(arguments):
            raw = arguments[index + 1]
        elif arg.startswith("-destination="):
            raw = arg.split("=", 1)[1]
        if raw:
            yield dict(part.split("=", 1) for part in raw.split(",") if "=" in part)


def physical(destination):
    """Whether a destination is a phone rather than a simulator."""
    target = destination.get("id") or destination.get("name")
    if any(target in pair for pair in SIMULATORS) or destination.get("platform") == "iOS Simulator":
        return False
    simulator_id = re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", destination.get("id", ""))
    return destination.get("platform") == "iOS" or not simulator_id


def build_arguments(arguments):
    jobs = os.environ.get("XCODE_AGENT_JOBS", "6")
    if not re.fullmatch(r"[1-9][0-9]*", jobs):
        raise ValueError("XCODE_AGENT_JOBS must be a positive integer")
    result = []
    index = 0
    while index < len(arguments):
        arg = arguments[index]
        if arg in ("-jobs", "-parallel-testing-enabled", "-maximum-concurrent-test-simulator-destinations"):
            if index + 1 >= len(arguments):
                raise ValueError(f"{arg} requires a value")
            index += 2
            continue
        if arg.startswith(("-jobs=", "-parallel-testing-enabled=", "-maximum-concurrent-test-simulator-destinations=")):
            index += 1
            continue
        result.append(arg)
        index += 1
    for destination in destinations(arguments):
        target = destination.get("id") or destination.get("name")
        if target and not physical(destination):
            check_simulator(target)
        elif "name" in destination and "platform" not in destination:
            raise ValueError("named destinations outside the shared pool require an explicit platform")
    result.extend(("-jobs", jobs))
    if {"test", "test-without-building", "build-for-testing"} & set(actions(arguments)):
        result.extend(("-parallel-testing-enabled", "NO", "-maximum-concurrent-test-simulator-destinations", "1"))
    return result


def process_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def duration(seconds):
    seconds = int(seconds)
    return f"{seconds // 60}m{seconds % 60:02d}s" if seconds >= 60 else f"{seconds}s"


def requester():
    try:
        root = subprocess.run(["/usr/bin/git", "rev-parse", "--show-toplevel"], capture_output=True,
                              text=True, check=True, timeout=10).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        root = os.getcwd()
    return "/".join(Path(root).parts[-2:])


def locked(path):
    try:
        with open(path) as ticket:
            fcntl.flock(ticket, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    except FileNotFoundError:
        pass
    return False


def process_started(pid):
    """When a process started, as text that reads the same in every caller's locale and time zone."""
    try:
        return subprocess.run(["/bin/ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True,
                              timeout=5, env={"LC_ALL": "C", "TZ": "UTC"}).stdout.strip()
    except subprocess.SubprocessError:
        return ""


@dataclasses.dataclass
class Ticket:
    path: Path
    pid: int = 0
    label: str = "?"
    action: str = "?"
    queued_at: float = 0
    started_at: float = 0
    child: int = 0
    child_started: str = ""

    def __str__(self):
        return f"{self.label} {self.action}"

    @classmethod
    def read(cls, path):
        try:
            return cls(path, **json.loads(path.read_text()))
        except (OSError, ValueError, TypeError):
            return cls(path)


# The queues this process holds, in the order it took them.
HELD = []


class Queue:
    """First come, first served use of one machine-wide resource.

    Every requester holds flock on a numbered ticket and touches it while it
    waits or supervises Xcode. The lowest ticket runs once no other is
    running. Numbers are never reused.

    Whoever reads the line, under the guard lock, also clears it of requesters
    that cannot take their turn. One that died or stalled while waiting keeps
    its place as a reservation, so a run that a tool timeout killed rejoins
    where it stood. A running ticket with no heartbeat has lost its supervisor,
    so nobody is waiting for its result and its Xcode is stopped.
    """

    def __init__(self, resource, root=None, label="?", action="?"):
        self.resource = resource
        self.directory = Path(root or STATE / "queues") / resource
        self.label = label
        self.action = action
        self.ticket = None
        self.file = None
        self.watched = {}
        self.signalled = {}

    @contextlib.contextmanager
    def guard(self, patience=None):
        self.directory.mkdir(parents=True, exist_ok=True)
        with (self.directory / "guard").open("a+") as guard:
            # A terminal stop (Ctrl-Z) that landed inside the guard would block every other requester.
            signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTSTP})
            try:
                deadline = time.monotonic() + (patience or 0)
                while True:
                    try:
                        fcntl.flock(guard, fcntl.LOCK_EX | (fcntl.LOCK_NB if patience else 0))
                        break
                    except BlockingIOError:
                        if time.monotonic() > deadline:
                            raise TimeoutError(f"a suspended ios-agent holds {guard.name}")
                        time.sleep(0.05)
                yield guard
            finally:
                signal.pthread_sigmask(signal.SIG_UNBLOCK, {signal.SIGTSTP})

    def stalled(self, path):
        """Seconds this process has watched a ticket go without a heartbeat.

        Counted on the monotonic clock from what this process saw, so a Mac
        that slept does not make every ticket look abandoned on wake.
        """
        now = time.monotonic()
        beat = path.stat().st_mtime_ns
        if self.watched.get(path, (None, 0))[0] != beat:
            self.watched[path] = (beat, now)
        return now - self.watched[path][1]

    def line(self):
        """The live tickets in order. Call under the guard."""
        result = []
        for path in sorted(self.directory.glob("[0-9]*")):
            try:
                if path.suffix:
                    if time.time() - path.stat().st_mtime > RESERVED:
                        path.unlink()
                    continue
                ticket = Ticket.read(path)
                stalled = self.stalled(path) if locked(path) else None
                if stalled is None or (stalled > STALE and not ticket.started_at):
                    self.vacate(ticket)
                elif stalled > STALE and self.orphaned(ticket, stalled):
                    path.unlink()
                else:
                    result.append(ticket)
            except FileNotFoundError:
                continue
        return result

    def vacate(self, ticket):
        if ticket.started_at or ticket.label == "?":
            ticket.path.unlink()
        else:
            reserved = ticket.path.with_suffix(".reserved")
            ticket.path.rename(reserved)
            os.utime(reserved)

    def orphaned(self, ticket, stalled):
        """Stops the Xcode of a running ticket nobody supervises. True once the ticket is to be dropped."""
        now = time.monotonic()
        if now - self.signalled.get(ticket.path, 0) < 1:
            return False
        self.signalled[ticket.path] = now
        # The pid may belong to another process by now.
        if ticket.child and ticket.child_started and process_started(ticket.child) == ticket.child_started:
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(ticket.child, signal.SIGTERM if stalled < STALE * 1.25 else signal.SIGKILL)
            # Its flock ends with it, and the ticket then leaves the line as a dead one.
            return False
        # No Xcode left to stop: a suspended supervisor, or a run that holds this queue while it waits for another.
        return stalled > STALE * 1.5

    def join(self, guard):
        if self.file:
            self.file.close()
        for path in sorted(self.directory.glob("*.reserved")):
            reserved = Ticket.read(path)
            if reserved.label != self.label:
                continue
            file = path.open("r+")
            try:
                fcntl.flock(file, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                file.close()
                continue
            path = path.rename(path.with_suffix(""))
            queued_at = reserved.queued_at
            break
        else:
            guard.seek(0)
            counter = guard.read()
            taken = [int(path.stem) for path in self.directory.glob("[0-9]*")]
            number = max(taken + [int(counter) if counter.isdigit() else 0]) + 1
            guard.seek(0)
            guard.truncate()
            guard.write(str(number))
            guard.flush()
            path = self.directory / f"{number:012d}"
            file = path.open("x")
            fcntl.flock(file, fcntl.LOCK_EX)
            queued_at = time.time()
        self.file = file
        self.ticket = Ticket(path, os.getpid(), self.label, self.action, queued_at)
        self.record()

    def record(self):
        self.file.seek(0)
        self.file.truncate()
        json.dump({key: value for key, value in dataclasses.asdict(self.ticket).items() if key != "path"}, self.file)
        self.file.flush()

    def beat(self):
        os.utime(self.file.fileno())

    def tickets(self, patience=None):
        with self.guard(patience):
            return self.line()

    def owned(self):
        """Whether this process still has its place. One that stalled may have been dropped from the line."""
        with self.guard():
            try:
                return os.fstat(self.file.fileno()).st_ino == self.ticket.path.stat().st_ino
            except FileNotFoundError:
                return False

    def waiters(self):
        return [ticket for ticket in self.tickets() if ticket.path != self.ticket.path]

    def held_by_parent(self):
        return any(Path(path).parent == self.directory and locked(path)
                   for path in os.environ.get("IOS_AGENT_HELD", "").split(os.pathsep) if path)

    def __enter__(self):
        announced = None
        while True:
            with self.guard() as guard:
                line = self.line()
                # Not in the line yet, or dropped from it while this process was stalled.
                if not self.ticket or all(ticket.path != self.ticket.path for ticket in line):
                    self.join(guard)
                    line = self.line()
                mine = self.ticket.path
                ahead = [ticket for ticket in line
                         if ticket.path != mine and (ticket.started_at or ticket.path.name < mine.name)]
                if not ahead:
                    self.ticket.started_at = time.time()
                    self.record()
                    break
            now = time.time()
            runner = next((ticket for ticket in ahead if ticket.started_at), None)
            change = (len(ahead), runner and runner.path)
            if announced is None or change != announced[0] or now - announced[1] >= 30:
                first = (f"running now: {runner}" + time.strftime(" since %H:%M:%S", time.localtime(runner.started_at))
                         if runner else f"next: {ahead[0]}")
                report("queued", f"{self.resource}: position {len(ahead) + 1} of {len(line)}; {first}")
                announced = (change, now)
            for queue in HELD + [self]:
                queue.beat()
            time.sleep(0.25)
        HELD.append(self)
        return self

    def __exit__(self, *unused):
        HELD.remove(self)
        self.ticket.path.unlink(missing_ok=True)
        self.file.close()


def report(state, detail):
    """Tells the caller where this run is. The wrappers read the status file."""
    if state == "queued":
        log(f"queued for {detail}")
    path = os.environ.get("IOS_AGENT_STATUS_FILE")
    if path:
        with contextlib.suppress(OSError):
            temporary = Path(f"{path}.{os.getpid()}")
            temporary.write_text(f"{state}\t{detail}\n")
            temporary.replace(path)


def hold_limit():
    limit = float(os.environ.get("IOS_AGENT_HOLD_LIMIT_MINUTES", "30"))
    if not (math.isfinite(limit) and limit > 0):
        raise ValueError("IOS_AGENT_HOLD_LIMIT_MINUTES must be a positive number")
    return limit * 60


def supervise(command, queues=(), environment=None):
    child = None
    received = []
    limit = hold_limit()

    def forward(signum, frame):
        received.append(signum)
        if child is not None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(child.pid, signum)

    watched = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    previous = {sig: signal.signal(sig, forward) for sig in watched}
    try:
        child = subprocess.Popen(command, start_new_session=True, env=environment,
                                 pass_fds=[queue.file.fileno() for queue in queues])
        if received:
            forward(received[-1], None)
        started = beat = time.monotonic()
        identity = process_started(child.pid)
        for queue in queues:
            queue.ticket.child, queue.ticket.child_started = child.pid, identity
            with queue.guard():
                queue.record()
        checked = 0
        deadline = None
        expired = False
        while child.poll() is None:
            now = time.monotonic()
            if now - beat >= min(1, STALE / 4):
                beat = now
                for queue in queues:
                    queue.beat()
            if received:
                deadline = deadline or now + 10
                if now > deadline:
                    with contextlib.suppress(ProcessLookupError):
                        os.killpg(child.pid, signal.SIGKILL)
            elif now - started > limit and now - checked >= min(5, limit):
                checked = now
                if any(queue.waiters() for queue in queues):
                    log(f"stopped after {duration(now - started)} because other agents are waiting; "
                        "the user can raise IOS_AGENT_HOLD_LIMIT_MINUTES")
                    expired = True
                    forward(signal.SIGTERM, None)
            time.sleep(0.1)
        if expired:
            return 124
        return 128 + received[0] if received else (child.returncode if child.returncode >= 0 else 128 - child.returncode)
    finally:
        # An error above must not give up the queue while Xcode still runs.
        if child is not None and child.poll() is None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(child.pid, signal.SIGTERM)
            try:
                child.wait(timeout=10)
            except subprocess.TimeoutExpired:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(child.pid, signal.SIGKILL)
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def resources(arguments):
    """The queues an invocation holds, in the one order every invocation takes them.

    Phones come before the build queue, so no run keeps compiles waiting while
    it waits for a phone.
    """
    requested = set(actions(arguments))
    devices = set()
    if requested & {"test", "test-without-building"}:
        for destination in destinations(arguments):
            if physical(destination) and destination.get("platform", "iOS") == "iOS":
                if "id" not in destination:
                    raise ValueError("name a phone by id, so test runs on it wait for each other; "
                                     "ios-agent devices lists the ids")
                devices.add("device-" + re.sub(r"[^A-Za-z0-9._-]", "_", destination["id"]))
    return sorted(devices) + ([] if requested == {"test-without-building"} else ["build"])


def xcodebuild(arguments, executable="/usr/bin/xcodebuild", queue_root=None):
    command = [executable] if isinstance(executable, str) else list(executable)
    if any(arg in QUERIES for arg in arguments) and not actions(arguments):
        os.execv(command[0], command + arguments)
    arguments = build_arguments(arguments)
    nice = int(os.environ.get("XCODE_AGENT_NICE", "10"))
    if not 0 <= nice <= 19:
        raise ValueError("XCODE_AGENT_NICE must be from 0 to 19")
    hold_limit()
    label = requester()
    action = (actions(arguments) or ["build"])[0]
    arrived = time.time()
    needed = resources(arguments)
    while True:
        with contextlib.ExitStack() as stack:
            queues = []
            for resource in needed:
                queue = Queue(resource, queue_root, label, action)
                # A build script that runs xcodebuild must not wait behind its own build.
                if not queue.held_by_parent():
                    queues.append(stack.enter_context(queue))
            if all(queue.owned() for queue in queues):
                return run(command + arguments, queues, nice, arrived)


def run(command, queues, nice, arrived):
    os.nice(max(0, nice - os.getpriority(os.PRIO_PROCESS, 0)))
    waited = time.time() - arrived
    log(f"running Xcode with {command[command.index('-jobs') + 1]} workers"
        + (f" after {duration(waited)} queued" if waited >= 1 else ""))
    report("running", str(int(time.time())))
    environment = dict(os.environ)
    environment.pop("IOS_AGENT_STATUS_FILE", None)
    environment["IOS_AGENT_HELD"] = os.pathsep.join(
        [environment.get("IOS_AGENT_HELD", "")] + [str(queue.ticket.path) for queue in queues]).strip(os.pathsep)
    return supervise(command, queues, environment)


def xcrun(arguments):
    index = 0
    while index < len(arguments) and arguments[index].startswith("-"):
        option = arguments[index]
        if option in ("-f", "--find"):
            os.execv("/usr/bin/xcrun", ["/usr/bin/xcrun"] + arguments)
        index += 2 if option in ("--sdk", "-sdk", "--toolchain", "-toolchain") else 1
    if index < len(arguments) and arguments[index] == "xcodebuild":
        return xcodebuild(arguments[index + 1:], ["/usr/bin/xcrun"] + arguments[:index + 1])
    if index < len(arguments) and arguments[index] == "simctl":
        index += 1
        while index < len(arguments) and arguments[index].startswith("-"):
            index += 2 if arguments[index] in ("--set", "--profiles") else 1
        if len(arguments) < index + 2:
            os.execv("/usr/bin/xcrun", ["/usr/bin/xcrun"] + arguments)
        action, target = arguments[index:index + 2]
        if action == "boot" or (action == "bootstatus" and "-b" in arguments):
            grant_simulator(target)
    os.execv("/usr/bin/xcrun", ["/usr/bin/xcrun"] + arguments)


def device_json(arguments):
    result = subprocess.run(["/usr/bin/xcrun", "devicectl"] + arguments + [
        "--quiet", "--timeout", "5", "--json-output", "-", "--omit-deprecated-fields-in-json"
    ], capture_output=True, text=True, timeout=8, check=True)
    return json.loads(result.stdout)["result"]


@dataclasses.dataclass
class Device:
    name: str
    udid: str
    connected: bool
    allowed: bool
    eligible: bool
    reason: str


def physical_devices(document, lock_state):
    devices = []
    for item in document.get("devices", []):
        properties = item.get("properties", {})
        hardware = properties.get("hardware", {})
        if hardware.get("fidelity") != "physical":
            continue
        state = properties.get("state", {})
        connection = properties.get("connection", {})
        udid = hardware.get("udid", "")
        allowed = udid in APPROVED_DEVICES
        connected = connection.get("state") == "connected"
        reason = "ready"
        if not allowed:
            reason = "not approved for automatic agent runs"
        elif not connected:
            reason = "offline"
        elif connection.get("pairingState") != "paired":
            reason = "not paired"
        elif "enabled" not in state.get("developerModeStatus", {}):
            reason = "developer mode unavailable"
        elif hardware.get("productFamily") != "iPhone":
            reason = "not an iPhone"
        elif not DEVICE_FEATURES.issubset(
            capability.get("featureIdentifier") for capability in item.get("capabilities", [])
        ):
            reason = "Xcode device services unavailable"
        else:
            try:
                status = lock_state(udid)
                if status.get("passcodeRequired") is not False or status.get("unlockedSinceBoot") is not True:
                    reason = "locked or not unlocked since boot"
            except (subprocess.SubprocessError, OSError, ValueError, KeyError):
                reason = "lock state unavailable"
        devices.append(Device(state.get("name", udid), udid, connected, allowed, reason == "ready", reason))
    return devices


def discover():
    return physical_devices(device_json(["list", "devices"]),
                            lambda udid: device_json(["device", "info", "lockState", "--device", udid]))


def status(queue_root=None, lock_root=None, library=None):
    """Who holds and who waits for everything agents share on this Mac."""
    now = time.time()
    queue_root = Path(queue_root or STATE / "queues")
    queues = {"build": []}
    for directory in [queue_root / "build"] + sorted(queue_root.glob("device-*")):
        try:
            queues[directory.name] = Queue(directory.name, queue_root).tickets(patience=2)
        except TimeoutError:
            queues[directory.name] = None
    # A run holds a queue without running while it waits for its other one.
    queues = {name: tickets and [{"label": ticket.label, "action": ticket.action, "pid": ticket.pid,
                                  "state": "running" if ticket.child else "holding" if ticket.started_at else "waiting",
                                  "seconds": int(now - (ticket.started_at or ticket.queued_at))}
                                 for ticket in tickets]
              for name, tickets in queues.items() if tickets != [] or name == "build"}
    lock_root = Path(lock_root or os.environ.get("AGENT_SIMULATOR_LOCK_ROOT", "/tmp/agent-locks"))
    simulators = []
    for slot, (name, unused) in enumerate(SIMULATORS):
        simulator = {"name": name, "holder": None}
        try:
            worktree, pid, used = (lock_root / ("simulator" if slot == 0 else f"simulator-{slot + 1}") / "owner").read_text().strip().split("|")
            simulator.update(holder="/".join(Path(worktree).parts[-2:]), kind="process" if pid else "session",
                             minutes=int((now - int(used)) / 60))
        except (OSError, ValueError):
            pass
        simulators.append(simulator)
    # scripts/lock keeps one file per process waiting for a simulator: "owner|locks", named by arrival time.
    waiting = []
    for place in sorted((lock_root / ".waiting").glob("[0-9]*-[0-9]*")):
        try:
            worktree, wanted = place.read_text().strip().split("|")
            if not place.suffix and time.time() - place.stat().st_mtime <= 30:
                waiting.append({"label": "/".join(Path(worktree).parts[-2:]),
                                "wants": [SIMULATORS[int(lock[10:] or 1) - 1][0] for lock in wanted.split()],
                                "minutes": int((now - int(place.name.split("-")[0])) / 60)})
        except (OSError, ValueError, IndexError):
            pass
    library = Path(library or Path.home() / ".local/lib/ios-agent")
    controller = {"repo": None, "commit": None, "current": False}
    try:
        controller.update(json.loads((library / "source.json").read_text()))
        latest = subprocess.run(["/usr/bin/git", "-C", controller["repo"], "show", "main:scripts/ios-agent"],
                                capture_output=True, check=True, timeout=10).stdout
        controller["current"] = latest == (library / "ios-agent").read_bytes()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        pass
    return {"queues": queues, "simulators": simulators, "simulator_waiters": waiting, "controller": controller}


def print_status(document):
    for name, tickets in document["queues"].items():
        if tickets is None:
            print(f"{name}: cannot read the line, because a suspended ios-agent holds its guard file")
        elif not tickets:
            print(f"{name}: idle")
        for ticket in tickets or []:
            print(f"{name}: {ticket['label']} {ticket['action']}, {ticket['state']} {duration(ticket['seconds'])}")
    for simulator in document["simulators"]:
        if simulator["holder"] is None:
            print(f"{simulator['name']}: free")
        elif simulator["kind"] == "session":
            print(f"{simulator['name']}: {simulator['holder']}, session last used {simulator['minutes']} min ago")
        else:
            print(f"{simulator['name']}: {simulator['holder']}, in use for {simulator['minutes']} min")
    for waiter in document["simulator_waiters"]:
        print(f"{' or '.join(waiter['wants'])}: {waiter['label']}, waiting {waiter['minutes']} min")
    controller = document["controller"]
    if controller["current"]:
        print(f"controller: {controller['commit'][:8]} from {controller['repo']}")
    else:
        print("controller: differs from scripts/ios-agent on Paeonia main; "
              "run scripts/ios-agent install-user in that checkout")


def clean_environment():
    """The environment for git and for the tests, without what a git hook or a user override adds."""
    return {key: value for key, value in os.environ.items() if not key.startswith(("GIT_", "XCODE_", "IOS_AGENT_"))}


def converge(path, content, executable=False):
    if path.exists() and path.read_bytes() == content:
        return False
    temporary = path.with_name(f"{path.name}-{os.getpid()}")
    temporary.write_bytes(content)
    if executable:
        temporary.chmod(0o755)
    temporary.replace(path)
    return True


def install_controller(origin, library, checks, replace):
    """Installs the controller that HEAD of main commits, after its own tests pass.

    Every agent on this Mac runs the installed copy, so only bytes that are
    committed, tested and not older than the installed ones get in. Older is
    judged by content: the installed bytes must appear in this main's history
    of the file, which an amended or rebased commit still satisfies.
    """
    def git(*arguments):
        return subprocess.run(["/usr/bin/git", "-C", str(origin.parent), *arguments], capture_output=True,
                              check=True, timeout=30, env=clean_environment()).stdout

    source = library / "ios-agent"
    # One install at a time, so a slower one cannot finish over a newer one.
    with (library / "install.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            commit = git("rev-parse", "HEAD").decode().strip()
            controller = git("show", f"{commit}:./{origin.name}")
            on_main = git("branch", "--show-current").decode().strip() == "main"
            record = json.dumps({"repo": git("rev-parse", "--show-toplevel").decode().strip(), "commit": commit}).encode()
            if source.exists() and source.read_bytes() == controller:
                if on_main:
                    converge(library / "source.json", record)
                return
            suite = git("show", f"{commit}:./test-ios-agent.py")
            if source.exists() and not replace:
                installed = git("hash-object", "--no-filters", str(source)).decode().strip()
                try:
                    known = git("log", "-1", "--format=%H", f"--find-object={installed}", commit, "--", origin.name)
                except subprocess.CalledProcessError:
                    known = b""
        except (subprocess.SubprocessError, OSError):
            raise ValueError("refusing to install: scripts/ios-agent and its tests must be committed in a git checkout")
        if not on_main:
            raise ValueError("refusing to install: the controller installs only from a checkout of main")
        if source.exists() and not replace and not known.strip():
            raise ValueError("refusing to install: the installed controller is not in this main's history of "
                             "scripts/ios-agent, so this one may be older. If this main is the right one, run "
                             "scripts/ios-agent install-user --replace")
        with tempfile.TemporaryDirectory() as directory:
            (Path(directory) / "ios-agent").write_bytes(controller)
            (Path(directory) / "test-ios-agent.py").write_bytes(suite)
            try:
                passed = subprocess.run(checks or ["/usr/bin/python3", "test-ios-agent.py"], cwd=directory,
                                        capture_output=True, timeout=600, env=clean_environment()).returncode == 0
            except subprocess.TimeoutExpired:
                passed = False
        if not passed:
            raise ValueError("refusing to install: scripts/test-ios-agent.py fails for the committed controller")
        converge(source, controller, executable=True)
        converge(library / "source.json", record)


def install_user(home=None, launchd=True, checks=None, replace=False):
    home = Path(home or Path.home())
    library = home / ".local/lib/ios-agent"
    library.mkdir(parents=True, exist_ok=True)
    source = library / "ios-agent"
    origin = Path(__file__).resolve()
    if origin != source.resolve():
        install_controller(origin, library, checks, replace)
    binary = home / ".local/bin/ios-agent"
    binary.parent.mkdir(parents=True, exist_ok=True)
    converge(binary, f'#!/bin/sh\nexec /usr/bin/python3 "{source}" "$@"\n'.encode(), executable=True)
    for name in ("xcodebuild", "xcrun"):
        converge(library / name, f'#!/bin/sh\nexec /usr/bin/python3 "{source}" {name} "$@"\n'.encode(), executable=True)
    launch_agent = home / "Library/LaunchAgents/no.hkarlsen.ios-agent.plist"
    launch_agent.parent.mkdir(parents=True, exist_ok=True)
    log_path = home / "Library/Logs/ios-agent.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    changed = converge(launch_agent, plistlib.dumps({
        "Label": "no.hkarlsen.ios-agent",
        "ProgramArguments": ["/usr/bin/python3", str(source), "enforce-simulators"],
        "RunAtLoad": True, "StartInterval": 30,
        "StandardOutPath": str(log_path), "StandardErrorPath": str(log_path),
    }))
    if launchd:
        service = f"gui/{os.getuid()}/no.hkarlsen.ios-agent"
        if changed or subprocess.run(["/bin/launchctl", "print", service], capture_output=True).returncode != 0:
            subprocess.run(["/bin/launchctl", "bootout", service], capture_output=True)
            subprocess.run(["/bin/launchctl", "bootstrap", f"gui/{os.getuid()}", str(launch_agent)], check=True)
    print(library)


def main(arguments=None):
    arguments = list(sys.argv[1:] if arguments is None else arguments)
    if arguments and arguments[0] in ("xcodebuild", "xcrun"):
        command = arguments.pop(0)
        return xcodebuild(arguments) if command == "xcodebuild" else xcrun(arguments)
    if arguments and arguments[0] == "simulator-lease":
        if len(arguments) not in (2, 3):
            raise ValueError("simulator-lease requires a shared simulator name or ID and optional TTL seconds")
        grant_simulator(arguments[1], ttl_seconds=int(arguments[2]) if len(arguments) == 3 else None)
        return 0
    if arguments == ["enforce-simulators"]:
        enforce_simulators()
        return 0
    parser = argparse.ArgumentParser(description="Shared Mac build queue and live iPhone discovery")
    parser.add_argument("command", choices=("devices", "destination", "physical-destination", "install-user", "status"))
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--simulator", action="store_true")
    parser.add_argument("--replace", action="store_true",
                        help="install-user: replace an installed controller that is not in this main's history")
    options = parser.parse_args(arguments)
    if options.command == "install-user":
        install_user(replace=options.replace)
        return 0
    if options.command == "status":
        document = status()
        if options.json:
            print(json.dumps(document, indent=2))
        else:
            print_status(document)
        return 0
    devices = []
    if not options.simulator:
        try:
            devices = discover()
        except (subprocess.SubprocessError, OSError, ValueError, KeyError) as error:
            log(f"device discovery unavailable ({error}); using Shared iPhone")
            if options.command == "devices":
                return 1
    if options.command == "devices":
        if options.json:
            print(json.dumps([dataclasses.asdict(device) for device in devices], indent=2))
        else:
            for device in devices:
                print(f"{device.name}\t{device.udid}\t{'connected' if device.connected else 'offline'}\t{device.reason}")
        return 0
    eligible = next((device for device in devices if device.eligible), None)
    if eligible:
        print(f"platform=iOS,id={eligible.udid}")
    elif options.command == "destination":
        print("platform=iOS Simulator,name=Shared iPhone")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError) as error:
        log(str(error))
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
