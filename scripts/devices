#!/usr/bin/env bash
# Drives the developer's own iPhone and iPad, each on its own, for anything a
# real device shows better than a simulator. They are signed in as the two
# partners of a couple on api.paeonia.no. docs/agent-guides/devices.md says
# when to use them and what to leave alone.
#
#   scripts/devices status                       which device is connected, and who holds it
#   scripts/devices install [iphone] [ipad]      build this worktree for devices, then install
#                                                and launch on the ones named, or on every
#                                                connected one
#   scripts/devices <iphone|ipad> <command...>   one agent-device command on that device
#   scripts/devices logs <iphone|ipad> <start> [category]
#                                                collect its system log since <start>
#                                                ("YYYY-MM-DD HH:MM:SS") and print Paeonia's
#                                                lines, or one category's, such as CallStats
#   scripts/devices release [iphone] [ipad]      close the sessions, restart a running Paeonia
#                                                and give the devices back
#
# Each device has its own lock (scripts/lock device-iphone, device-ipad), so two
# worktrees can each drive one, and a session frees itself 10 minutes after its
# last command. agent-device commands take points, the screenshot's pixels
# divided by the screen's scale (3 on the iPhone, 2 on the iPad). `logs` needs
# a USB cable and opens the macOS password dialog for `log collect`.
set -euo pipefail

IPHONE_NAME="Cold Harbor"
IPHONE_UDID="00008160-0006155E2628000A"
IPAD_NAME="Allentown"
IPAD_UDID="00008112-000E04523C06201E"
BUNDLE_ID="no.paeonia.app"

ROOT="$(git rev-parse --show-toplevel)"
PRODUCTION_BACKEND="https://api.paeonia.no"
STATE_ROOT="$(git rev-parse --path-format=absolute --git-common-dir)/paeonia-devices"

usage() {
  sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

udid_of() {
  case "$1" in
    iphone) echo "$IPHONE_UDID" ;;
    ipad) echo "$IPAD_UDID" ;;
    *) echo "devices: say iphone or ipad, not '$1'" >&2; exit 2 ;;
  esac
}

# Paired devices on a cable or the network. devicectl's State column says
# "connected" only while the device's tunnel is up, "available (paired)" while
# it idles, and "unavailable" once the device is unplugged and off the network.
# devicectl commands on the device, and agent-device's own readiness check,
# bring the tunnel back up.
connected_udids() {
  xcrun devicectl list devices --hide-default-columns --hide-headers --columns properties.hardware.udid \
    --filter "properties.connection.pairingState = 'paired' AND State != 'unavailable'" 2>/dev/null |
    grep -oE '[0-9A-F]{8}-[0-9A-F]{16}' || true
}

is_connected() {
  connected_udids | grep -qx "$1"
}

# Stops with a clear message when the device is not plugged in or on the network.
require_connected() {
  is_connected "$(udid_of "$1")" || { echo "devices: $1 is not connected (scripts/devices status)" >&2; exit 1; }
}

take_lock() {
  "$ROOT/scripts/lock" acquire "device-$1" 2> >(grep -v "is held by this worktree" >&2) >/dev/null
}

# agent-device's daemon keeps the working directory of the command that started
# it. Once that worktree is removed, it can no longer start xcodebuild and every
# command fails with "xcodebuild not found in PATH". Stop such a daemon, so the
# next command starts a new one here. The sessions it held are opened again.
stop_orphaned_daemon() {
  local pid cwd
  # No daemon.json while no daemon has started, and no live process once it exited.
  pid="$(sed -n 's/^ *"pid": *\([0-9][0-9]*\).*/\1/p' "$STATE_ROOT/agent-device/daemon.json" 2>/dev/null || true)"
  [[ -n "$pid" ]] || return 0
  cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' || true)"
  if [[ -n "$cwd" && ! -d "$cwd" ]]; then
    # Its device runners (xcodebuild under ios-agent) would outlive it and keep
    # each phone's test queue, so every later command waits behind them.
    kill "$pid" $(descendants "$pid") 2>/dev/null || true
    echo "devices: restarted agent-device, whose folder $cwd was removed" >&2
  fi
}

descendants() {
  local child
  for child in $(pgrep -P "$1"); do
    echo "$child"
    descendants "$child"
  done
}

agent_device() {
  local version
  version="$(ls "$HOME/.t3/tools/agent-device" 2>/dev/null | sort -V | tail -1)"
  local bin="$HOME/.t3/tools/agent-device/$version/node_modules/agent-device/bin/agent-device.mjs"
  if [[ -z "$version" || ! -f "$bin" ]]; then
    echo "devices: agent-device is missing from ~/.t3/tools/agent-device; open a T3 Device panel once to install it" >&2
    exit 1
  fi
  mkdir -p "$STATE_ROOT/agent-device"
  stop_orphaned_daemon
  AGENT_DEVICE_IOS_TEAM_ID=48ZSLD4RMP \
    AGENT_DEVICE_IOS_BUNDLE_ID=no.hkarlsen.agentdevice.runner \
    AGENT_DEVICE_STATE_DIR="$STATE_ROOT/agent-device" \
    node "$bin" "$@"
}

cmd_status() {
  local connected
  connected="$(connected_udids)"
  for device in iphone ipad; do
    local udid name
    udid="$(udid_of "$device")"
    name=$([[ $device == iphone ]] && echo "$IPHONE_NAME" || echo "$IPAD_NAME")
    if grep -qx "$udid" <<<"$connected"; then
      echo "$device: $name connected"
    else
      echo "$device: $name not connected"
    fi
  done
  DevToolsSecurity -status 2>/dev/null | sed 's/^/mac: /'
  "$ROOT/scripts/lock" status 2>/dev/null | grep "^device-" || true
}

cmd_install() {
  local targets=("$@")
  if [[ $# -eq 0 ]]; then
    for device in iphone ipad; do
      is_connected "$(udid_of "$device")" && targets+=("$device")
    done
    [[ ${#targets[@]} -gt 0 ]] || { echo "devices: neither device is connected" >&2; exit 1; }
  fi
  for device in "${targets[@]}"; do
    require_connected "$device"
  done
  XCODE_BUILD_AGENT_DESTINATION="generic/platform=iOS" "$ROOT/scripts/xcode-build-agent.sh" | tail -1
  local app=""
  for plist in "$HOME"/Library/Developer/Xcode/DerivedData/Paeonia-*/info.plist; do
    if [[ "$(/usr/libexec/PlistBuddy -c "Print WorkspacePath" "$plist" 2>/dev/null)" == "$ROOT/"* ]]; then
      app="$(dirname "$plist")/Build/Products/Debug-iphoneos/PaeoniaApp.app"
    fi
  done
  [[ -d "$app" ]] || { echo "devices: found no device build for $ROOT" >&2; exit 1; }
  # The developer's devices are signed in to production. A build for a local
  # backend (ios/local.xcconfig from scripts/local-backend) uses the development
  # Clerk instance, so installing it signs the partner on that device out.
  local backend
  backend="$(/usr/libexec/PlistBuddy -c "Print PaeoniaConvexURL" "$app/Info.plist" 2>/dev/null || true)"
  # PAEONIA_DEVICES_ALLOW_LOCAL_BACKEND=1 allows it when the developer agreed to it
  # for this task. Whoever installs it reinstalls a production build afterwards.
  if [[ "$backend" != "$PRODUCTION_BACKEND" && "${PAEONIA_DEVICES_ALLOW_LOCAL_BACKEND:-}" != 1 ]]; then
    echo "devices: this build talks to ${backend:-no backend}, not $PRODUCTION_BACKEND. The devices are signed in to production, so installing it would sign them out. Delete ios/local.xcconfig and build again, or test on a simulator. If the developer agreed to it for this task, set PAEONIA_DEVICES_ALLOW_LOCAL_BACKEND=1, and reinstall a production build when you are done." >&2
    exit 1
  fi
  for device in "${targets[@]}"; do
    take_lock "$device"
    local udid
    udid="$(udid_of "$device")"
    xcrun devicectl device install app --device "$udid" "$app" >/dev/null
    xcrun devicectl device process launch --device "$udid" --terminate-existing "$BUNDLE_ID" >/dev/null
    echo "$device: installed $(/usr/libexec/PlistBuddy -c "Print CFBundleVersion" "$app/Info.plist") and launched"
  done
}

cmd_drive() {
  local device="$1"
  shift
  local udid
  udid="$(udid_of "$device")"
  [[ $# -gt 0 ]] || usage
  require_connected "$device"
  take_lock "$device"
  if [[ "$1" == open ]]; then
    agent_device "$@" --udid "$udid" --session "$device"
  else
    agent_device "$@" --session "$device"
  fi
}

cmd_logs() {
  [[ $# -eq 2 || $# -eq 3 ]] || usage
  local device="$1" start="$2" category="${3:-}"
  local udid
  udid="$(udid_of "$device")"
  require_connected "$device"
  take_lock "$device"
  local out
  out="${TMPDIR:-/tmp}/paeonia-device-logs/$device-$(date +%Y%m%d-%H%M%S).logarchive"
  mkdir -p "$(dirname "$out")"
  osascript -e "do shell script \"/usr/bin/log collect --device-udid $udid --start '$start' --output '$out' && chown -R $(id -un) '$out'\" with administrator privileges" >/dev/null
  echo "archive: $out" >&2
  local predicate='subsystem == "no.paeonia.app"'
  [[ -n "$category" ]] && predicate+=" AND category == \"$category\""
  /usr/bin/log show "$out" --style compact --predicate "$predicate"
}

cmd_release() {
  local targets=(iphone ipad)
  [[ $# -gt 0 ]] && targets=("$@")
  for device in "${targets[@]}"; do
    udid_of "$device" >/dev/null
    agent_device close --session "$device" >/dev/null 2>&1 || true
    # A Paeonia that agent-device drove keeps SwiftUI's accessibilityEnabled on
    # after the session ends, which shows extra controls until
    # it restarts. Restart a running one so the developer gets the normal app.
    local udid
    udid="$(udid_of "$device")"
    if xcrun devicectl device info processes --device "$udid" 2>/dev/null | grep -qE '/PaeoniaApp\.app/PaeoniaApp *$'; then
      xcrun devicectl device process launch --device "$udid" --terminate-existing "$BUNDLE_ID" >/dev/null 2>&1 || true
    fi
    "$ROOT/scripts/lock" release "device-$device" 2>/dev/null || true
  done
}

case "${1:-}" in
  status) cmd_status ;;
  install) shift; cmd_install "$@" ;;
  iphone | ipad) cmd_drive "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  release) shift; cmd_release "$@" ;;
  *) usage ;;
esac
