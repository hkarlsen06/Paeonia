#!/usr/bin/env python3
import argparse
import copy
import ctypes
import ctypes.util
import fcntl
import functools
import json
import shutil
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from pathlib import Path
from typing import Optional


DEFAULT_REQUIRED_LOCALES = ("en", "nb")
VALID_STATES = ("new", "needs_review", "stale", "translated")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Add or update a plain stringUnit entry in an Xcode .xcstrings catalog. "
            "Changing English or Norwegian marks the key's other existing translations "
            "as needs_review, except locales supplied in the same command."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  scripts/xcstrings-set ios/PaeoniaApp/Resources/Localization/Localizable.xcstrings pairing.invite.button \\
    --comment "Button that starts partner invitation" \\
    --en "Invite partner" \\
    --nb "Inviter partner"

  scripts/xcstrings-set ios/PaeoniaWidget/Resources/Localization/Localizable.xcstrings widget.title \\
    --comment "Widget display name" \\
    --en "Paeonia" \\
    --nb "Paeonia"
""",
    )
    parser.add_argument("catalog", type=Path, help="Path to the .xcstrings file.")
    parser.add_argument("key", help="String catalog key to add or update.")
    parser.add_argument("--comment", help="Translator context for the key.")
    parser.add_argument("--en", help="English value.")
    parser.add_argument("--nb", help="Norwegian Bokmal value.")
    parser.add_argument(
        "--locale",
        action="append",
        default=[],
        metavar="LOCALE=VALUE",
        help="Additional locale value. Can be passed more than once.",
    )
    parser.add_argument(
        "--state",
        default="translated",
        choices=VALID_STATES,
        help="stringUnit state to write for provided locale values.",
    )
    parser.add_argument(
        "--extraction-state",
        help="Set the entry extractionState. New entries default to manual.",
    )
    parser.add_argument(
        "--allow-missing-comment",
        action="store_true",
        help="Allow a new key without a translator comment.",
    )
    parser.add_argument(
        "--allow-complex",
        action="store_true",
        help="Allow overwriting entries with variations or substitutions.",
    )
    parser.add_argument(
        "--skip-xcstringstool-check",
        action="store_true",
        help="Skip the xcrun xcstringstool compile dry-run check.",
    )
    return parser.parse_args()


def fail(message: str) -> None:
    print(f"xcstrings-set: {message}", file=sys.stderr)
    raise SystemExit(2)


def parse_locale_assignments(args: argparse.Namespace) -> dict[str, str]:
    localizations: dict[str, str] = {}

    if args.en is not None:
        localizations["en"] = args.en
    if args.nb is not None:
        localizations["nb"] = args.nb

    for assignment in args.locale:
        if "=" not in assignment:
            fail(f"--locale must use LOCALE=VALUE, got {assignment!r}")
        locale, value = assignment.split("=", 1)
        locale = locale.strip()
        if not locale:
            fail("--locale locale code cannot be empty")
        localizations[locale] = value

    return localizations


def load_catalog(path: Path) -> dict:
    if path.suffix != ".xcstrings":
        fail(f"expected a .xcstrings file, got {path}")
    if not path.exists():
        fail(f"catalog does not exist: {path}")

    try:
        with path.open("r", encoding="utf-8") as file:
            catalog = json.load(file)
    except json.JSONDecodeError as error:
        fail(f"invalid JSON in {path}: {error}")

    if not isinstance(catalog, dict):
        fail("catalog root must be a JSON object")
    if "strings" not in catalog or not isinstance(catalog["strings"], dict):
        fail("catalog must contain a strings object")

    return catalog


def entry_is_plain_string_unit(entry: dict) -> bool:
    localizations = entry.get("localizations", {})
    if localizations is None:
        return True
    if not isinstance(localizations, dict):
        return False

    for locale_entry in localizations.values():
        if not isinstance(locale_entry, dict):
            return False
        if set(locale_entry.keys()) - {"stringUnit"}:
            return False
        string_unit = locale_entry.get("stringUnit")
        if string_unit is not None and not isinstance(string_unit, dict):
            return False

    return True


def mark_translation_needs_review(value: dict) -> None:
    for key, child in value.items():
        if not isinstance(child, dict):
            continue
        if key == "stringUnit":
            child["state"] = "needs_review"
        else:
            mark_translation_needs_review(child)


def update_catalog(
    catalog: dict,
    key: str,
    comment: Optional[str],
    locale_values: dict[str, str],
    state: str,
    extraction_state: Optional[str],
    allow_missing_comment: bool,
    allow_complex: bool,
) -> tuple[bool, list[str]]:
    strings = catalog["strings"]
    is_new_entry = key not in strings

    if is_new_entry:
        missing = [
            locale
            for locale in DEFAULT_REQUIRED_LOCALES
            if locale not in locale_values
        ]
        if missing:
            fail(
                "new keys require localized values for "
                + ", ".join(DEFAULT_REQUIRED_LOCALES)
                + f"; missing {', '.join(missing)}"
            )
        if comment is None and not allow_missing_comment:
            fail("new keys require --comment for translator context")
        strings[key] = {
            "extractionState": extraction_state or "manual",
            "localizations": {},
        }

    entry = strings[key]
    if not isinstance(entry, dict):
        fail(f"{key} is not a string entry object")
    if not allow_complex and not entry_is_plain_string_unit(entry):
        fail(
            f"{key} contains variations or substitutions; use Xcode/XLIFF "
            "or pass --allow-complex if you are intentionally replacing it"
        )

    if extraction_state is not None:
        entry["extractionState"] = extraction_state
    elif is_new_entry and "extractionState" not in entry:
        entry["extractionState"] = "manual"

    if comment is not None:
        entry["comment"] = comment

    localizations = entry.setdefault("localizations", {})
    if not isinstance(localizations, dict):
        fail(f"{key}.localizations is not an object")

    source_changed = False
    for locale, value in locale_values.items():
        locale_entry = localizations.setdefault(locale, {})
        if not isinstance(locale_entry, dict):
            fail(f"{key}.localizations.{locale} is not an object")
        if not allow_complex and set(locale_entry.keys()) - {"stringUnit"}:
            fail(
                f"{key}.localizations.{locale} is not a plain stringUnit; "
                "use Xcode/XLIFF for complex entries"
            )
        previous_unit = locale_entry.get("stringUnit")
        if locale in DEFAULT_REQUIRED_LOCALES and (
            not isinstance(previous_unit, dict) or previous_unit.get("value") != value
        ):
            source_changed = True
        locale_entry["stringUnit"] = {
            "state": state,
            "value": value,
        }

    # A changed source text makes the key's other translations out of date.
    changed_locales = list(locale_values.keys())
    if source_changed:
        for locale, locale_entry in localizations.items():
            if locale not in DEFAULT_REQUIRED_LOCALES and locale not in locale_values:
                if isinstance(locale_entry, dict):
                    mark_translation_needs_review(locale_entry)
                    changed_locales.append(locale)

    return is_new_entry, changed_locales


# Xcode's String Catalog editor orders keys like Foundation's
# localizedStandardCompare, which needs ICU collation, so ask CoreFoundation.
_cf = ctypes.CDLL(ctypes.util.find_library("CoreFoundation"))
_cf.CFStringCreateWithCString.restype = ctypes.c_void_p
_cf.CFStringCreateWithCString.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_uint32]
_cf.CFStringGetLength.restype = ctypes.c_long
_cf.CFStringGetLength.argtypes = [ctypes.c_void_p]
_cf.CFRelease.argtypes = [ctypes.c_void_p]
_cf.CFLocaleCopyCurrent.restype = ctypes.c_void_p


class _CFRange(ctypes.Structure):
    _fields_ = [("location", ctypes.c_long), ("length", ctypes.c_long)]


_cf.CFStringCompareWithOptionsAndLocale.restype = ctypes.c_long
_cf.CFStringCompareWithOptionsAndLocale.argtypes = [
    ctypes.c_void_p, ctypes.c_void_p, _CFRange, ctypes.c_ulong, ctypes.c_void_p,
]
# Case insensitive, numeric, width insensitive and forced ordering, in the
# current locale: the options localizedStandardCompare uses.
_STANDARD_COMPARE = 1 | 64 | 256 | 512
_CURRENT_LOCALE = _cf.CFLocaleCopyCurrent()


def xcode_key_order(keys) -> list:
    keys = list(keys)
    refs = {key: _cf.CFStringCreateWithCString(None, key.encode("utf-8"), 0x08000100) for key in keys}
    try:
        def compare(a, b):
            ref = refs[a]
            whole = _CFRange(0, _cf.CFStringGetLength(ref))
            return _cf.CFStringCompareWithOptionsAndLocale(
                ref, refs[b], whole, _STANDARD_COMPARE, _CURRENT_LOCALE
            )
        return sorted(keys, key=functools.cmp_to_key(compare))
    finally:
        for ref in refs.values():
            _cf.CFRelease(ref)


def serialize_catalog(catalog: dict) -> str:
    """Writes the catalog exactly as Xcode's String Catalog editor saves it, so a
    later save in Xcode changes nothing: every object's keys in
    localizedStandardCompare order, two-space indent, `" : "` between key and
    value, an empty object as `{`, a blank line and `}`, and no newline at the
    end."""

    def dump(value, depth: int) -> str:
        outer = "  " * depth
        inner = "  " * (depth + 1)
        if isinstance(value, dict):
            if not value:
                return "{\n\n" + outer + "}"
            members = (
                f"{inner}{json.dumps(key, ensure_ascii=False)} : {dump(value[key], depth + 1)}"
                for key in xcode_key_order(value)
            )
            return "{\n" + ",\n".join(members) + "\n" + outer + "}"
        if isinstance(value, list):
            if not value:
                return "[\n\n" + outer + "]"
            items = (inner + dump(item, depth + 1) for item in value)
            return "[\n" + ",\n".join(items) + "\n" + outer + "]"
        return json.dumps(value, ensure_ascii=False)

    return dump(catalog, 0)


@contextmanager
def exclusive_catalog_lock(path: Path):
    """Serializes edits, so two agents adding keys at once can't overwrite each other."""
    lock_path = Path(f"{path}.lock")
    with lock_path.open("a+", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def write_and_validate(path: Path, content: str, skip_xcstringstool_check: bool) -> None:
    """Writes the catalog and puts the original back if the result doesn't compile."""
    original_content = path.read_text(encoding="utf-8")
    path.write_text(content, encoding="utf-8")
    try:
        json.loads(content)
        if not skip_xcstringstool_check:
            run_xcstringstool_check(path)
    except BaseException:
        path.write_text(original_content, encoding="utf-8")
        raise


def run_xcstringstool_check(path: Path) -> None:
    if shutil.which("xcrun") is None:
        print(
            "xcstrings-set: warning: xcrun not found; skipped xcstringstool validation",
            file=sys.stderr,
        )
        return

    with tempfile.TemporaryDirectory(prefix="xcstrings-set-") as output_dir:
        result = subprocess.run(
            [
                "xcrun",
                "xcstringstool",
                "compile",
                str(path),
                "--output-directory",
                output_dir,
                "--dry-run",
            ],
            capture_output=True,
            text=True,
            check=False,
        )

    if result.returncode != 0:
        if result.stdout:
            print(result.stdout, file=sys.stderr)
        if result.stderr:
            print(result.stderr, file=sys.stderr)
        raise SystemExit(result.returncode)


def main() -> None:
    args = parse_args()
    locale_values = parse_locale_assignments(args)

    if not locale_values and args.comment is None and args.extraction_state is None:
        fail("nothing to update; pass --en, --nb, --locale, --comment, or --extraction-state")

    with exclusive_catalog_lock(args.catalog):
        catalog = load_catalog(args.catalog)
        original_catalog = copy.deepcopy(catalog)

        is_new_entry, changed_locales = update_catalog(
            catalog=catalog,
            key=args.key,
            comment=args.comment,
            locale_values=locale_values,
            state=args.state,
            extraction_state=args.extraction_state,
            allow_missing_comment=args.allow_missing_comment,
            allow_complex=args.allow_complex,
        )

        content = serialize_catalog(catalog)
        existing_content = args.catalog.read_text(encoding="utf-8")

        if content == existing_content:
            print(f"No changes for {args.key} in {args.catalog}")
            return

        write_and_validate(args.catalog, content, args.skip_xcstringstool_check)

    action = "Added" if is_new_entry else "Updated"
    locale_summary = ", ".join(changed_locales) if changed_locales else "metadata only"
    if catalog == original_catalog:
        locale_summary = "formatting only"
    print(f"{action} {args.key} in {args.catalog} ({locale_summary})")


if __name__ == "__main__":
    # Formats catalog JSON from stdin the way Xcode saves it, for any other script
    # that writes a catalog, such as a future translator.
    if sys.argv[1:] == ["--format-stdin"]:
        sys.stdout.write(serialize_catalog(json.load(sys.stdin)))
        raise SystemExit(0)
    main()
